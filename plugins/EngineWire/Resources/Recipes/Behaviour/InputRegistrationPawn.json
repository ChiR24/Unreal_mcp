{
  "description": "Registers an Enhanced Input mapping context on a Pawn when a PlayerController possesses it. Only a locally controlled PlayerController has the subsystem (a server's copy of a remote player's has no LocalPlayer), so a Branch on IsValid skips the rest. McpBlueprintBehaviour adds this to a recipe whose input section needs a context this Blueprint does not register yet; its nodes are shared (comment 'MCP input context') and never removed.",
  "tag": "MCP input context",
  "placeholders": {
    "MappingContext": "Object path of the Input Mapping Context to register, e.g. /Game/Input/IMC_MCP.IMC_MCP."
  },
  "hooks": [
    { "id": "__imc", "event": "ReceiveControllerChanged" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "__imcCast", "nodeType": "Cast", "targetClass": "PlayerController" },
    { "edit": "create_node", "id": "__imcSub", "nodeType": "K2Node_GetSubsystemFromPC", "targetClass": "/Script/EnhancedInput.EnhancedInputLocalPlayerSubsystem" },
    { "edit": "create_node", "id": "__imcValid", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "__imcLocal", "nodeType": "Branch" },
    { "edit": "create_node", "id": "__imcAdd", "nodeType": "CallFunction", "memberName": "AddMappingContext", "memberClass": "/Script/EnhancedInput.EnhancedInputLocalPlayerSubsystem", "pinDefaults": { "MappingContext": "{{MappingContext}}", "Priority": 0 } },
    { "edit": "connect_pins", "from": "$__imc_event.NewController", "to": "$__imcCast.Object" },
    { "edit": "connect_pins", "from": "$__imcCast.AsPlayer Controller", "to": "$__imcSub.PlayerController" },
    { "edit": "connect_pins", "from": "$__imcSub.ReturnValue", "to": "$__imcValid.Object" },
    { "edit": "connect_pins", "from": "$__imcValid.ReturnValue", "to": "$__imcLocal.Condition" },
    { "edit": "connect_pins", "from": "$__imcSub.ReturnValue", "to": "$__imcAdd.self" },
    { "edit": "connect_pins", "from": "$__imc.then", "to": "$__imcCast.execute" },
    { "edit": "connect_pins", "from": "$__imcCast.then", "to": "$__imcLocal.execute" },
    { "edit": "connect_pins", "from": "$__imcLocal.then", "to": "$__imcAdd.execute" }
  ]
}
