{
  "description": "The AI controller keeps its focus on the first actor carrying FocusTag: every frame it has no focus actor, it gets all actors with the tag and focuses the first (Set Focus), so a target that spawns later, or is replaced, is picked up again. While no actor carries the tag it searches every frame. A focused AI pawn that uses its controller's rotation turns to face the focus.",
  "tag": "MCP AI focus",
  "placeholders": {
    "FocusTag": "The actor tag that marks the target (add it with control_actor add_tag)."
  },
  "hooks": [
    { "id": "focusTick", "event": "Tick" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "focusCurrent", "nodeType": "CallFunction", "memberName": "GetFocusActor", "memberClass": "/Script/AIModule.AIController" },
    { "edit": "create_node", "id": "focusHas", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "focusNeeded", "nodeType": "Branch" },
    { "edit": "create_node", "id": "focusTagged", "nodeType": "CallFunction", "memberName": "GetAllActorsWithTag", "memberClass": "/Script/Engine.GameplayStatics", "pinDefaults": { "Tag": "{{FocusTag}}" } },
    { "edit": "create_node", "id": "focusTarget", "nodeType": "CallFunction", "memberName": "Array_Get", "memberClass": "/Script/Engine.KismetArrayLibrary", "pinDefaults": { "Index": 0 } },
    { "edit": "create_node", "id": "focusFound", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "focusFoundBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "focusSet", "nodeType": "CallFunction", "memberName": "K2_SetFocus", "memberClass": "/Script/AIModule.AIController" },
    { "edit": "connect_pins", "from": "$focusTick.then", "to": "$focusNeeded.execute" },
    { "edit": "connect_pins", "from": "$focusCurrent.ReturnValue", "to": "$focusHas.Object" },
    { "edit": "connect_pins", "from": "$focusHas.ReturnValue", "to": "$focusNeeded.Condition" },
    { "edit": "connect_pins", "from": "$focusNeeded.else", "to": "$focusTagged.execute" },
    { "edit": "connect_pins", "from": "$focusTagged.OutActors", "to": "$focusTarget.TargetArray" },
    { "edit": "connect_pins", "from": "$focusTagged.then", "to": "$focusFoundBranch.execute" },
    { "edit": "connect_pins", "from": "$focusTarget.Item", "to": "$focusFound.Object" },
    { "edit": "connect_pins", "from": "$focusFound.ReturnValue", "to": "$focusFoundBranch.Condition" },
    { "edit": "connect_pins", "from": "$focusFoundBranch.then", "to": "$focusSet.execute" },
    { "edit": "connect_pins", "from": "$focusTarget.Item", "to": "$focusSet.NewFocus" }
  ]
}
