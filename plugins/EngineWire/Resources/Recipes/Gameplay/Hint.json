{
  "description": "A hint on the player's screen: when a locally controlled pawn starts to overlap the actor (a sign, a tutorial area), the widget goes on that player's view showing HintMessage, and it goes when the pawn leaves, or HideAfter seconds after it came when that is above 0. Each placed copy can say its own HintMessage. The actor needs a component that overlaps pawns.",
  "tag": "Hint",
  "placeholders": {
    "WidgetClass": "The hint widget's generated class path.",
    "WidgetType": "Object:<widget class path>, the type of the variable holding the shown widget.",
    "TextName": "The TextBlock in the widget that shows the message.",
    "Message": "The text shown.",
    "HideAfter": "Seconds the hint stays once shown; 0 keeps it while the pawn stays."
  },
  "variables": [
    { "variableName": "HintMessage", "variableType": "String", "defaultValue": "{{Message}}", "category": "Hint", "instanceEditable": true },
    { "variableName": "HintHideAfter", "variableType": "Float", "defaultValue": "{{HideAfter}}", "category": "Hint", "instanceEditable": true },
    { "variableName": "HintShown", "variableType": "{{WidgetType}}", "category": "Hint" }
  ],
  "functions": [
    {
      "id": "hintHide",
      "functionName": "HideHint",
      "operations": [
        { "edit": "create_node", "id": "hhShown", "nodeType": "VariableGet", "memberName": "HintShown" },
        { "edit": "create_node", "id": "hhValid", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
        { "edit": "create_node", "id": "hhBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "hhRemove", "nodeType": "CallFunction", "memberName": "RemoveFromParent", "memberClass": "/Script/UMG.Widget" },
        { "edit": "create_node", "id": "hhClear", "nodeType": "VariableSet", "memberName": "HintShown" },
        { "edit": "connect_pins", "from": "$hhShown.HintShown", "to": "$hhValid.Object" },
        { "edit": "connect_pins", "from": "$hhValid.ReturnValue", "to": "$hhBranch.Condition" },
        { "edit": "connect_pins", "from": "$hhShown.HintShown", "to": "$hhRemove.self" },
        { "edit": "connect_pins", "from": "$hintHide.then", "to": "$hhBranch.execute" },
        { "edit": "connect_pins", "from": "$hhBranch.then", "to": "$hhRemove.execute" },
        { "edit": "connect_pins", "from": "$hhRemove.then", "to": "$hhClear.execute" }
      ]
    }
  ],
  "hooks": [
    { "id": "hintIn", "event": "ActorBeginOverlap" },
    { "id": "hintOut", "event": "ActorEndOverlap" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "hiWho", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "hiLocal", "nodeType": "CallFunction", "memberName": "IsLocallyControlled", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "hiLocalBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "hiController", "nodeType": "CallFunction", "memberName": "GetController", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "hiPlayer", "nodeType": "Cast", "targetClass": "/Script/Engine.PlayerController" },
    { "edit": "create_node", "id": "hiHideFirst", "nodeType": "CallFunction", "memberName": "HideHint" },
    { "edit": "create_node", "id": "hiCreate", "nodeType": "K2Node_CreateWidget", "targetClass": "{{WidgetClass}}" },
    { "edit": "create_node", "id": "hiKeep", "nodeType": "VariableSet", "memberName": "HintShown" },
    { "edit": "create_node", "id": "hiShow", "nodeType": "CallFunction", "memberName": "AddToViewport", "memberClass": "/Script/UMG.UserWidget", "pinDefaults": { "ZOrder": 40 } },
    { "edit": "create_node", "id": "hiText", "nodeType": "VariableGet", "memberName": "{{TextName}}", "memberClass": "{{WidgetClass}}" },
    { "edit": "create_node", "id": "hiMessage", "nodeType": "VariableGet", "memberName": "HintMessage" },
    { "edit": "create_node", "id": "hiToText", "nodeType": "CallFunction", "memberName": "Conv_StringToText", "memberClass": "/Script/Engine.KismetTextLibrary" },
    { "edit": "create_node", "id": "hiSetText", "nodeType": "CallFunction", "memberName": "SetText", "memberClass": "/Script/UMG.TextBlock" },
    { "edit": "create_node", "id": "hiAfter", "nodeType": "VariableGet", "memberName": "HintHideAfter" },
    { "edit": "create_node", "id": "hiTimed", "nodeType": "CallFunction", "memberName": "Greater_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "hiTimedBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "hiSelf", "nodeType": "Self" },
    { "edit": "create_node", "id": "hiTimer", "nodeType": "CallFunction", "memberName": "K2_SetTimer", "memberClass": "/Script/Engine.KismetSystemLibrary", "pinDefaults": { "FunctionName": "HideHint", "bLooping": false } },
    { "edit": "connect_pins", "from": "$hintIn_event.OtherActor", "to": "$hiWho.Object" },
    { "edit": "connect_pins", "from": "$hiWho.AsPawn", "to": "$hiLocal.self" },
    { "edit": "connect_pins", "from": "$hiLocal.ReturnValue", "to": "$hiLocalBranch.Condition" },
    { "edit": "connect_pins", "from": "$hiWho.AsPawn", "to": "$hiController.self" },
    { "edit": "connect_pins", "from": "$hiController.ReturnValue", "to": "$hiPlayer.Object" },
    { "edit": "connect_pins", "from": "$hiPlayer.AsPlayer Controller", "to": "$hiCreate.OwningPlayer" },
    { "edit": "connect_pins", "from": "$hiCreate.ReturnValue", "to": "$hiKeep.HintShown" },
    { "edit": "connect_pins", "from": "$hiCreate.ReturnValue", "to": "$hiShow.self" },
    { "edit": "connect_pins", "from": "$hiCreate.ReturnValue", "to": "$hiText.self" },
    { "edit": "connect_pins", "fromNodeId": "$hiText", "fromPinName": "{{TextName}}", "toNodeId": "$hiSetText", "toPinName": "self" },
    { "edit": "connect_pins", "from": "$hiMessage.HintMessage", "to": "$hiToText.InString" },
    { "edit": "connect_pins", "from": "$hiToText.ReturnValue", "to": "$hiSetText.InText" },
    { "edit": "connect_pins", "from": "$hiAfter.HintHideAfter", "to": "$hiTimed.A" },
    { "edit": "connect_pins", "from": "$hiTimed.ReturnValue", "to": "$hiTimedBranch.Condition" },
    { "edit": "connect_pins", "from": "$hiSelf.self", "to": "$hiTimer.Object" },
    { "edit": "connect_pins", "from": "$hiAfter.HintHideAfter", "to": "$hiTimer.Time" },
    { "edit": "connect_pins", "from": "$hintIn.then", "to": "$hiWho.execute" },
    { "edit": "connect_pins", "from": "$hiWho.then", "to": "$hiLocalBranch.execute" },
    { "edit": "connect_pins", "from": "$hiLocalBranch.then", "to": "$hiPlayer.execute" },
    { "edit": "connect_pins", "from": "$hiPlayer.then", "to": "$hiHideFirst.execute" },
    { "edit": "connect_pins", "from": "$hiHideFirst.then", "to": "$hiCreate.execute" },
    { "edit": "connect_pins", "from": "$hiCreate.then", "to": "$hiKeep.execute" },
    { "edit": "connect_pins", "from": "$hiKeep.then", "to": "$hiShow.execute" },
    { "edit": "connect_pins", "from": "$hiShow.then", "to": "$hiSetText.execute" },
    { "edit": "connect_pins", "from": "$hiSetText.then", "to": "$hiTimedBranch.execute" },
    { "edit": "connect_pins", "from": "$hiTimedBranch.then", "to": "$hiTimer.execute" },

    { "edit": "create_node", "id": "hoWho", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "hoLocal", "nodeType": "CallFunction", "memberName": "IsLocallyControlled", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "hoAfter", "nodeType": "VariableGet", "memberName": "HintHideAfter" },
    { "edit": "create_node", "id": "hoWhileIn", "nodeType": "CallFunction", "memberName": "LessEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "hoBoth", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "hoBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "hoHide", "nodeType": "CallFunction", "memberName": "HideHint" },
    { "edit": "connect_pins", "from": "$hintOut_event.OtherActor", "to": "$hoWho.Object" },
    { "edit": "connect_pins", "from": "$hoWho.AsPawn", "to": "$hoLocal.self" },
    { "edit": "connect_pins", "from": "$hoAfter.HintHideAfter", "to": "$hoWhileIn.A" },
    { "edit": "connect_pins", "from": "$hoLocal.ReturnValue", "to": "$hoBoth.A" },
    { "edit": "connect_pins", "from": "$hoWhileIn.ReturnValue", "to": "$hoBoth.B" },
    { "edit": "connect_pins", "from": "$hoBoth.ReturnValue", "to": "$hoBranch.Condition" },
    { "edit": "connect_pins", "from": "$hintOut.then", "to": "$hoWho.execute" },
    { "edit": "connect_pins", "from": "$hoWho.then", "to": "$hoBranch.execute" },
    { "edit": "connect_pins", "from": "$hoBranch.then", "to": "$hoHide.execute" }
  ]
}
