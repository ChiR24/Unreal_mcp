{
  "description": "An enemy the player can stomp: when a player-controlled Character lands on top of the actor (a Hit whose normal points down at it), the Character bounces up at BounceSpeed and the actor dies: with bStompDestroys it is destroyed, else it takes damage enough to die (the Health behaviour's death). A player Character that bumps it from the side or below takes SideDamage, at most once a second; 0 for none.",
  "tag": "Stomp",
  "placeholders": {
    "Bounce": "Upward speed the stomping Character bounces off at.",
    "SideDamage": "Damage to a player Character that bumps it from the side or below; 0 for none.",
    "Destroys": "true when the actor has no Health behaviour, so a stomp destroys it."
  },
  "variables": [
    { "variableName": "BounceSpeed", "variableType": "Float", "defaultValue": "{{Bounce}}", "category": "Stomp", "instanceEditable": true },
    { "variableName": "SideDamage", "variableType": "Float", "defaultValue": "{{SideDamage}}", "category": "Stomp", "instanceEditable": true },
    { "variableName": "bStompDestroys", "variableType": "Bool", "defaultValue": "{{Destroys}}", "category": "Stomp" },
    { "variableName": "LastSideHurt", "variableType": "Float", "defaultValue": -1000, "category": "Stomp" }
  ],
  "hooks": [
    { "id": "stHit", "event": "Hit" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "stWho", "nodeType": "Cast", "targetClass": "/Script/Engine.Character" },
    { "edit": "create_node", "id": "stPlayer", "nodeType": "CallFunction", "memberName": "IsPlayerControlled", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "stPlayerBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "stNormal", "nodeType": "CallFunction", "memberName": "BreakVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "stOnTop", "nodeType": "CallFunction", "memberName": "Less_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": -0.7 } },
    { "edit": "create_node", "id": "stTopBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "stBounce", "nodeType": "VariableGet", "memberName": "BounceSpeed" },
    { "edit": "create_node", "id": "stUp", "nodeType": "CallFunction", "memberName": "MakeVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "stLaunch", "nodeType": "CallFunction", "memberName": "LaunchCharacter", "memberClass": "/Script/Engine.Character", "pinDefaults": { "bXYOverride": false, "bZOverride": true } },
    { "edit": "create_node", "id": "stDestroys", "nodeType": "VariableGet", "memberName": "bStompDestroys" },
    { "edit": "create_node", "id": "stDestroysBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "stGone", "nodeType": "CallFunction", "memberName": "K2_DestroyActor", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "stSelf", "nodeType": "Self" },
    { "edit": "create_node", "id": "stBy", "nodeType": "CallFunction", "memberName": "GetController", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "stKill", "nodeType": "CallFunction", "memberName": "ApplyDamage", "memberClass": "/Script/Engine.GameplayStatics", "pinDefaults": { "BaseDamage": 1000000 } },
    { "edit": "create_node", "id": "stSide", "nodeType": "VariableGet", "memberName": "SideDamage" },
    { "edit": "create_node", "id": "stSideOn", "nodeType": "CallFunction", "memberName": "Greater_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "stNow", "nodeType": "CallFunction", "memberName": "GetGameTimeInSeconds", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "stLast", "nodeType": "VariableGet", "memberName": "LastSideHurt" },
    { "edit": "create_node", "id": "stSince", "nodeType": "CallFunction", "memberName": "Subtract_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "stCooled", "nodeType": "CallFunction", "memberName": "GreaterEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
    { "edit": "create_node", "id": "stSideGo", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "stSideBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "stSelfSide", "nodeType": "Self" },
    { "edit": "create_node", "id": "stHurt", "nodeType": "CallFunction", "memberName": "ApplyDamage", "memberClass": "/Script/Engine.GameplayStatics" },
    { "edit": "create_node", "id": "stStamp", "nodeType": "VariableSet", "memberName": "LastSideHurt" },
    { "edit": "connect_pins", "from": "$stHit_event.Other", "to": "$stWho.Object" },
    { "edit": "connect_pins", "from": "$stWho.AsCharacter", "to": "$stPlayer.self" },
    { "edit": "connect_pins", "from": "$stPlayer.ReturnValue", "to": "$stPlayerBranch.Condition" },
    { "edit": "connect_pins", "from": "$stHit_event.HitNormal", "to": "$stNormal.InVec" },
    { "edit": "connect_pins", "from": "$stNormal.Z", "to": "$stOnTop.A" },
    { "edit": "connect_pins", "from": "$stOnTop.ReturnValue", "to": "$stTopBranch.Condition" },
    { "edit": "connect_pins", "from": "$stBounce.BounceSpeed", "to": "$stUp.Z" },
    { "edit": "connect_pins", "from": "$stWho.AsCharacter", "to": "$stLaunch.self" },
    { "edit": "connect_pins", "from": "$stUp.ReturnValue", "to": "$stLaunch.LaunchVelocity" },
    { "edit": "connect_pins", "from": "$stDestroys.bStompDestroys", "to": "$stDestroysBranch.Condition" },
    { "edit": "connect_pins", "from": "$stSelf.self", "to": "$stKill.DamagedActor" },
    { "edit": "connect_pins", "from": "$stWho.AsCharacter", "to": "$stBy.self" },
    { "edit": "connect_pins", "from": "$stBy.ReturnValue", "to": "$stKill.EventInstigator" },
    { "edit": "connect_pins", "from": "$stWho.AsCharacter", "to": "$stKill.DamageCauser" },
    { "edit": "connect_pins", "from": "$stSide.SideDamage", "to": "$stSideOn.A" },
    { "edit": "connect_pins", "from": "$stNow.ReturnValue", "to": "$stSince.A" },
    { "edit": "connect_pins", "from": "$stLast.LastSideHurt", "to": "$stSince.B" },
    { "edit": "connect_pins", "from": "$stSince.ReturnValue", "to": "$stCooled.A" },
    { "edit": "connect_pins", "from": "$stSideOn.ReturnValue", "to": "$stSideGo.A" },
    { "edit": "connect_pins", "from": "$stCooled.ReturnValue", "to": "$stSideGo.B" },
    { "edit": "connect_pins", "from": "$stSideGo.ReturnValue", "to": "$stSideBranch.Condition" },
    { "edit": "connect_pins", "from": "$stWho.AsCharacter", "to": "$stHurt.DamagedActor" },
    { "edit": "connect_pins", "from": "$stSide.SideDamage", "to": "$stHurt.BaseDamage" },
    { "edit": "connect_pins", "from": "$stSelfSide.self", "to": "$stHurt.DamageCauser" },
    { "edit": "connect_pins", "from": "$stNow.ReturnValue", "to": "$stStamp.LastSideHurt" },
    { "edit": "connect_pins", "from": "$stHit.then", "to": "$stWho.execute" },
    { "edit": "connect_pins", "from": "$stWho.then", "to": "$stPlayerBranch.execute" },
    { "edit": "connect_pins", "from": "$stPlayerBranch.then", "to": "$stTopBranch.execute" },
    { "edit": "connect_pins", "from": "$stTopBranch.then", "to": "$stLaunch.execute" },
    { "edit": "connect_pins", "from": "$stLaunch.then", "to": "$stDestroysBranch.execute" },
    { "edit": "connect_pins", "from": "$stDestroysBranch.then", "to": "$stGone.execute" },
    { "edit": "connect_pins", "from": "$stDestroysBranch.else", "to": "$stKill.execute" },
    { "edit": "connect_pins", "from": "$stTopBranch.else", "to": "$stSideBranch.execute" },
    { "edit": "connect_pins", "from": "$stSideBranch.then", "to": "$stHurt.execute" },
    { "edit": "connect_pins", "from": "$stHurt.then", "to": "$stStamp.execute" }
  ]
}
