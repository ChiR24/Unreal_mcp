{
  "description": "Health for an actor. Damage from any source (ApplyDamage, a pain causing volume, a projectile) lowers Health, clamped to 0..MaxHealth, and negative damage heals; OnHealthChanged reports each change and OnDied fires once when Health reaches 0, after which bIsDead stops further changes and bDestroyOnDeath destroys the actor. With InvulnerableTime above 0, damage within that many seconds of the last hit is ignored (heals still count). Heal(Amount) adds health up to MaxHealth. BeginPlay starts the actor at MaxHealth, so a placed copy with another MaxHealth starts full.",
  "tag": "Health",
  "placeholders": {
    "MaxHealth": "Starting and largest health, a number above 0.",
    "DestroyOnDeath": "true to destroy the actor when its health reaches 0.",
    "Invulnerable": "Seconds after a hit during which further damage is ignored; 0 for none."
  },
  "variables": [
    { "variableName": "MaxHealth", "variableType": "Float", "defaultValue": "{{MaxHealth}}", "category": "Health", "instanceEditable": true },
    { "variableName": "Health", "variableType": "Float", "defaultValue": "{{MaxHealth}}", "category": "Health" },
    { "variableName": "bIsDead", "variableType": "Bool", "defaultValue": false, "category": "Health" },
    { "variableName": "bDestroyOnDeath", "variableType": "Bool", "defaultValue": "{{DestroyOnDeath}}", "category": "Health", "instanceEditable": true },
    { "variableName": "InvulnerableTime", "variableType": "Float", "defaultValue": "{{Invulnerable}}", "category": "Health", "instanceEditable": true },
    { "variableName": "InvulnerableUntil", "variableType": "Float", "defaultValue": 0, "category": "Health" }
  ],
  "dispatchers": [
    { "name": "OnHealthChanged", "parameters": [{ "name": "NewHealth", "type": "Float" }] },
    { "name": "OnDied", "parameters": [] }
  ],
  "functions": [
    {
      "id": "heal",
      "functionName": "Heal",
      "inputs": [{ "name": "Amount", "type": "Float" }],
      "operations": [
        { "edit": "create_node", "id": "healDead", "nodeType": "VariableGet", "memberName": "bIsDead" },
        { "edit": "create_node", "id": "healAlive", "nodeType": "CallFunction", "memberName": "Not_PreBool", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "healBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "healHealth", "nodeType": "VariableGet", "memberName": "Health" },
        { "edit": "create_node", "id": "healAdd", "nodeType": "CallFunction", "memberName": "Add_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "healMax", "nodeType": "VariableGet", "memberName": "MaxHealth" },
        { "edit": "create_node", "id": "healMin", "nodeType": "CallFunction", "memberName": "FMin", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "healSet", "nodeType": "VariableSet", "memberName": "Health" },
        { "edit": "create_node", "id": "healNotify", "nodeType": "CallDelegate", "memberName": "OnHealthChanged" },
        { "edit": "connect_pins", "from": "$healDead.bIsDead", "to": "$healAlive.A" },
        { "edit": "connect_pins", "from": "$healAlive.ReturnValue", "to": "$healBranch.Condition" },
        { "edit": "connect_pins", "from": "$healHealth.Health", "to": "$healAdd.A" },
        { "edit": "connect_pins", "from": "$heal.Amount", "to": "$healAdd.B" },
        { "edit": "connect_pins", "from": "$healAdd.ReturnValue", "to": "$healMin.A" },
        { "edit": "connect_pins", "from": "$healMax.MaxHealth", "to": "$healMin.B" },
        { "edit": "connect_pins", "from": "$healMin.ReturnValue", "to": "$healSet.Health" },
        { "edit": "connect_pins", "from": "$healSet.Output_Get", "to": "$healNotify.NewHealth" },
        { "edit": "connect_pins", "from": "$heal.then", "to": "$healBranch.execute" },
        { "edit": "connect_pins", "from": "$healBranch.then", "to": "$healSet.execute" },
        { "edit": "connect_pins", "from": "$healSet.then", "to": "$healNotify.execute" }
      ]
    }
  ],
  "hooks": [
    { "id": "hpBegin", "event": "BeginPlay" },
    { "id": "hpDamage", "event": "AnyDamage" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "beginMax", "nodeType": "VariableGet", "memberName": "MaxHealth" },
    { "edit": "create_node", "id": "beginSet", "nodeType": "VariableSet", "memberName": "Health" },
    { "edit": "connect_pins", "from": "$beginMax.MaxHealth", "to": "$beginSet.Health" },
    { "edit": "connect_pins", "from": "$hpBegin.then", "to": "$beginSet.execute" },

    { "edit": "create_node", "id": "dmgDead", "nodeType": "VariableGet", "memberName": "bIsDead" },
    { "edit": "create_node", "id": "dmgAlive", "nodeType": "CallFunction", "memberName": "Not_PreBool", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgNow", "nodeType": "CallFunction", "memberName": "GetGameTimeInSeconds", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "dmgUntil", "nodeType": "VariableGet", "memberName": "InvulnerableUntil" },
    { "edit": "create_node", "id": "dmgReady", "nodeType": "CallFunction", "memberName": "GreaterEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgHeals", "nodeType": "CallFunction", "memberName": "LessEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "dmgAllowed", "nodeType": "CallFunction", "memberName": "BooleanOR", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgGo", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "dmgHurtBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "dmgWindow", "nodeType": "VariableGet", "memberName": "InvulnerableTime" },
    { "edit": "create_node", "id": "dmgUntilNext", "nodeType": "CallFunction", "memberName": "Add_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgStamp", "nodeType": "VariableSet", "memberName": "InvulnerableUntil" },
    { "edit": "create_node", "id": "dmgHealth", "nodeType": "VariableGet", "memberName": "Health" },
    { "edit": "create_node", "id": "dmgSub", "nodeType": "CallFunction", "memberName": "Subtract_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "dmgMax", "nodeType": "VariableGet", "memberName": "MaxHealth" },
    { "edit": "create_node", "id": "dmgClamp", "nodeType": "CallFunction", "memberName": "FClamp", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "Min": 0 } },
    { "edit": "create_node", "id": "dmgSet", "nodeType": "VariableSet", "memberName": "Health" },
    { "edit": "create_node", "id": "dmgNotify", "nodeType": "CallDelegate", "memberName": "OnHealthChanged" },
    { "edit": "create_node", "id": "dmgZero", "nodeType": "CallFunction", "memberName": "LessEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "dmgDiedBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "dmgSetDead", "nodeType": "VariableSet", "memberName": "bIsDead", "pinDefaults": { "bIsDead": true } },
    { "edit": "create_node", "id": "dmgDied", "nodeType": "CallDelegate", "memberName": "OnDied" },
    { "edit": "create_node", "id": "dmgDestroyFlag", "nodeType": "VariableGet", "memberName": "bDestroyOnDeath" },
    { "edit": "create_node", "id": "dmgDestroyBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "dmgDestroy", "nodeType": "CallFunction", "memberName": "K2_DestroyActor", "memberClass": "/Script/Engine.Actor" },
    { "edit": "connect_pins", "from": "$dmgDead.bIsDead", "to": "$dmgAlive.A" },
    { "edit": "connect_pins", "from": "$dmgNow.ReturnValue", "to": "$dmgReady.A" },
    { "edit": "connect_pins", "from": "$dmgUntil.InvulnerableUntil", "to": "$dmgReady.B" },
    { "edit": "connect_pins", "from": "$hpDamage_event.Damage", "to": "$dmgHeals.A" },
    { "edit": "connect_pins", "from": "$dmgReady.ReturnValue", "to": "$dmgAllowed.A" },
    { "edit": "connect_pins", "from": "$dmgHeals.ReturnValue", "to": "$dmgAllowed.B" },
    { "edit": "connect_pins", "from": "$dmgAlive.ReturnValue", "to": "$dmgGo.A" },
    { "edit": "connect_pins", "from": "$dmgAllowed.ReturnValue", "to": "$dmgGo.B" },
    { "edit": "connect_pins", "from": "$dmgGo.ReturnValue", "to": "$dmgBranch.Condition" },
    { "edit": "connect_pins", "from": "$dmgHeals.ReturnValue", "to": "$dmgHurtBranch.Condition" },
    { "edit": "connect_pins", "from": "$dmgNow.ReturnValue", "to": "$dmgUntilNext.A" },
    { "edit": "connect_pins", "from": "$dmgWindow.InvulnerableTime", "to": "$dmgUntilNext.B" },
    { "edit": "connect_pins", "from": "$dmgUntilNext.ReturnValue", "to": "$dmgStamp.InvulnerableUntil" },
    { "edit": "connect_pins", "from": "$dmgHealth.Health", "to": "$dmgSub.A" },
    { "edit": "connect_pins", "from": "$hpDamage_event.Damage", "to": "$dmgSub.B" },
    { "edit": "connect_pins", "from": "$dmgSub.ReturnValue", "to": "$dmgClamp.Value" },
    { "edit": "connect_pins", "from": "$dmgMax.MaxHealth", "to": "$dmgClamp.Max" },
    { "edit": "connect_pins", "from": "$dmgClamp.ReturnValue", "to": "$dmgSet.Health" },
    { "edit": "connect_pins", "from": "$dmgSet.Output_Get", "to": "$dmgNotify.NewHealth" },
    { "edit": "connect_pins", "from": "$dmgSet.Output_Get", "to": "$dmgZero.A" },
    { "edit": "connect_pins", "from": "$dmgZero.ReturnValue", "to": "$dmgDiedBranch.Condition" },
    { "edit": "connect_pins", "from": "$dmgDestroyFlag.bDestroyOnDeath", "to": "$dmgDestroyBranch.Condition" },
    { "edit": "connect_pins", "from": "$hpDamage.then", "to": "$dmgBranch.execute" },
    { "edit": "connect_pins", "from": "$dmgBranch.then", "to": "$dmgSet.execute" },
    { "edit": "connect_pins", "from": "$dmgSet.then", "to": "$dmgHurtBranch.execute" },
    { "edit": "connect_pins", "from": "$dmgHurtBranch.then", "to": "$dmgNotify.execute" },
    { "edit": "connect_pins", "from": "$dmgHurtBranch.else", "to": "$dmgStamp.execute" },
    { "edit": "connect_pins", "from": "$dmgStamp.then", "to": "$dmgNotify.execute" },
    { "edit": "connect_pins", "from": "$dmgNotify.then", "to": "$dmgDiedBranch.execute" },
    { "edit": "connect_pins", "from": "$dmgDiedBranch.then", "to": "$dmgSetDead.execute" },
    { "edit": "connect_pins", "from": "$dmgSetDead.then", "to": "$dmgDied.execute" },
    { "edit": "connect_pins", "from": "$dmgDied.then", "to": "$dmgDestroyBranch.execute" },
    { "edit": "connect_pins", "from": "$dmgDestroyBranch.then", "to": "$dmgDestroy.execute" }
  ]
}
