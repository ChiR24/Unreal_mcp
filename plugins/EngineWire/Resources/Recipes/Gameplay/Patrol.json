{
  "description": "A pawn that patrols: every PatrolInterval seconds its AI controller walks it to the next of PatrolPoints (offsets from where it started), and once it is there it waits PatrolWait seconds and takes the point after, looping. While the player's pawn is within ChaseRange (above 0) it chases the player instead, stopping StopDistance away, and goes back to its route once the player is out of range. With UsePathfinding it follows the navigation mesh, which needs a Nav Mesh Bounds Volume; without it the pawn heads straight for each point. The pawn must be possessed by an AI controller.",
  "tag": "Patrol",
  "placeholders": {
    "Points": "The route: an array of vector export texts, each an offset from where the pawn starts.",
    "WaitTime": "Seconds it waits at each point.",
    "ChaseRange": "Distance within which it chases the player, in units; 0 never chases.",
    "KeepChaseRange": "true keeps a ChaseRange the Blueprint already has (the caller gave none).",
    "StopDistance": "How close it gets to the player before it stops, in units.",
    "KeepStopDistance": "true keeps a StopDistance the Blueprint already has.",
    "UsePathfinding": "true to follow the navigation mesh, false to head straight for each point.",
    "KeepPathfinding": "true keeps a UsePathfinding the Blueprint already has."
  },
  "variables": [
    { "variableName": "PatrolPoints", "variableType": "Array:Vector", "defaultValue": "{{Points}}", "category": "Patrol", "instanceEditable": true },
    { "variableName": "PatrolWait", "variableType": "Float", "defaultValue": "{{WaitTime}}", "category": "Patrol", "instanceEditable": true },
    { "variableName": "ChaseRange", "variableType": "Float", "defaultValue": "{{ChaseRange}}", "keepExisting": "{{KeepChaseRange}}", "category": "Chase", "instanceEditable": true },
    { "variableName": "StopDistance", "variableType": "Float", "defaultValue": "{{StopDistance}}", "keepExisting": "{{KeepStopDistance}}", "category": "Chase", "instanceEditable": true },
    { "variableName": "UsePathfinding", "variableType": "Bool", "defaultValue": "{{UsePathfinding}}", "keepExisting": "{{KeepPathfinding}}", "category": "Chase", "instanceEditable": true },
    { "variableName": "PatrolInterval", "variableType": "Float", "defaultValue": 0.25, "category": "Patrol", "instanceEditable": true, "keepExisting": true },
    { "variableName": "PatrolIndex", "variableType": "Int", "defaultValue": 0, "category": "Patrol" },
    { "variableName": "PatrolOrigin", "variableType": "Vector", "category": "Patrol" },
    { "variableName": "PatrolResumeAt", "variableType": "Float", "defaultValue": 0, "category": "Patrol" }
  ],
  "functions": [
    {
      "id": "patrol",
      "functionName": "PatrolUpdate",
      "operations": [
        { "edit": "create_node", "id": "patController", "nodeType": "CallFunction", "memberName": "GetController", "memberClass": "/Script/Engine.Pawn" },
        { "edit": "create_node", "id": "patAI", "nodeType": "Cast", "targetClass": "/Script/AIModule.AIController" },
        { "edit": "create_node", "id": "patPlayer", "nodeType": "CallFunction", "memberName": "GetPlayerPawn", "memberClass": "/Script/Engine.GameplayStatics", "pinDefaults": { "PlayerIndex": 0 } },
        { "edit": "create_node", "id": "patValid", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
        { "edit": "create_node", "id": "patDistance", "nodeType": "CallFunction", "memberName": "GetDistanceTo", "memberClass": "/Script/Engine.Actor" },
        { "edit": "create_node", "id": "patRange", "nodeType": "VariableGet", "memberName": "ChaseRange" },
        { "edit": "create_node", "id": "patNear", "nodeType": "CallFunction", "memberName": "LessEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patArmed", "nodeType": "CallFunction", "memberName": "Greater_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
        { "edit": "create_node", "id": "patSeen", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patChase", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patChaseBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "patStop", "nodeType": "VariableGet", "memberName": "StopDistance" },
        { "edit": "create_node", "id": "patPath", "nodeType": "VariableGet", "memberName": "UsePathfinding" },
        { "edit": "create_node", "id": "patFollow", "nodeType": "CallFunction", "memberName": "MoveToActor", "memberClass": "/Script/AIModule.AIController", "pinDefaults": { "bCanStrafe": false } },
        { "edit": "create_node", "id": "patNow", "nodeType": "CallFunction", "memberName": "GetTimeSeconds", "memberClass": "/Script/Engine.GameplayStatics" },
        { "edit": "create_node", "id": "patResume", "nodeType": "VariableGet", "memberName": "PatrolResumeAt" },
        { "edit": "create_node", "id": "patWaiting", "nodeType": "CallFunction", "memberName": "Less_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patWaitBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "patPoints", "nodeType": "VariableGet", "memberName": "PatrolPoints" },
        { "edit": "create_node", "id": "patCount", "nodeType": "CallFunction", "memberName": "Array_Length", "memberClass": "/Script/Engine.KismetArrayLibrary" },
        { "edit": "create_node", "id": "patHas", "nodeType": "CallFunction", "memberName": "Greater_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
        { "edit": "create_node", "id": "patHasBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "patIndex", "nodeType": "VariableGet", "memberName": "PatrolIndex" },
        { "edit": "create_node", "id": "patItem", "nodeType": "CallFunction", "memberName": "Array_Get", "memberClass": "/Script/Engine.KismetArrayLibrary" },
        { "edit": "create_node", "id": "patOrigin", "nodeType": "VariableGet", "memberName": "PatrolOrigin" },
        { "edit": "create_node", "id": "patTarget", "nodeType": "CallFunction", "memberName": "Add_VectorVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patHere", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
        { "edit": "create_node", "id": "patGap", "nodeType": "CallFunction", "memberName": "Subtract_VectorVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patFlat", "nodeType": "CallFunction", "memberName": "VSizeXY", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patArrived", "nodeType": "CallFunction", "memberName": "LessEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 100 } },
        { "edit": "create_node", "id": "patArrivedBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "patNext", "nodeType": "CallFunction", "memberName": "Add_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
        { "edit": "create_node", "id": "patWrap", "nodeType": "CallFunction", "memberName": "Percent_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patSetIndex", "nodeType": "VariableSet", "memberName": "PatrolIndex" },
        { "edit": "create_node", "id": "patWaitFor", "nodeType": "VariableGet", "memberName": "PatrolWait" },
        { "edit": "create_node", "id": "patUntil", "nodeType": "CallFunction", "memberName": "Add_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
        { "edit": "create_node", "id": "patSetResume", "nodeType": "VariableSet", "memberName": "PatrolResumeAt" },
        { "edit": "create_node", "id": "patGo", "nodeType": "CallFunction", "memberName": "MoveToLocation", "memberClass": "/Script/AIModule.AIController", "pinDefaults": { "AcceptanceRadius": 50, "bCanStrafe": false } },
        { "edit": "connect_pins", "from": "$patController.ReturnValue", "to": "$patAI.Object" },
        { "edit": "connect_pins", "from": "$patPlayer.ReturnValue", "to": "$patValid.Object" },
        { "edit": "connect_pins", "from": "$patPlayer.ReturnValue", "to": "$patDistance.OtherActor" },
        { "edit": "connect_pins", "from": "$patDistance.ReturnValue", "to": "$patNear.A" },
        { "edit": "connect_pins", "from": "$patRange.ChaseRange", "to": "$patNear.B" },
        { "edit": "connect_pins", "from": "$patRange.ChaseRange", "to": "$patArmed.A" },
        { "edit": "connect_pins", "from": "$patValid.ReturnValue", "to": "$patSeen.A" },
        { "edit": "connect_pins", "from": "$patNear.ReturnValue", "to": "$patSeen.B" },
        { "edit": "connect_pins", "from": "$patSeen.ReturnValue", "to": "$patChase.A" },
        { "edit": "connect_pins", "from": "$patArmed.ReturnValue", "to": "$patChase.B" },
        { "edit": "connect_pins", "from": "$patChase.ReturnValue", "to": "$patChaseBranch.Condition" },
        { "edit": "connect_pins", "from": "$patAI.AsAIController", "to": "$patFollow.self" },
        { "edit": "connect_pins", "from": "$patPlayer.ReturnValue", "to": "$patFollow.Goal" },
        { "edit": "connect_pins", "from": "$patStop.StopDistance", "to": "$patFollow.AcceptanceRadius" },
        { "edit": "connect_pins", "from": "$patPath.UsePathfinding", "to": "$patFollow.bUsePathfinding" },
        { "edit": "connect_pins", "from": "$patNow.ReturnValue", "to": "$patWaiting.A" },
        { "edit": "connect_pins", "from": "$patResume.PatrolResumeAt", "to": "$patWaiting.B" },
        { "edit": "connect_pins", "from": "$patWaiting.ReturnValue", "to": "$patWaitBranch.Condition" },
        { "edit": "connect_pins", "from": "$patPoints.PatrolPoints", "to": "$patCount.TargetArray" },
        { "edit": "connect_pins", "from": "$patCount.ReturnValue", "to": "$patHas.A" },
        { "edit": "connect_pins", "from": "$patHas.ReturnValue", "to": "$patHasBranch.Condition" },
        { "edit": "connect_pins", "from": "$patPoints.PatrolPoints", "to": "$patItem.TargetArray" },
        { "edit": "connect_pins", "from": "$patIndex.PatrolIndex", "to": "$patItem.Index" },
        { "edit": "connect_pins", "from": "$patOrigin.PatrolOrigin", "to": "$patTarget.A" },
        { "edit": "connect_pins", "from": "$patItem.Item", "to": "$patTarget.B" },
        { "edit": "connect_pins", "from": "$patTarget.ReturnValue", "to": "$patGap.A" },
        { "edit": "connect_pins", "from": "$patHere.ReturnValue", "to": "$patGap.B" },
        { "edit": "connect_pins", "from": "$patGap.ReturnValue", "to": "$patFlat.A" },
        { "edit": "connect_pins", "from": "$patFlat.ReturnValue", "to": "$patArrived.A" },
        { "edit": "connect_pins", "from": "$patArrived.ReturnValue", "to": "$patArrivedBranch.Condition" },
        { "edit": "connect_pins", "from": "$patIndex.PatrolIndex", "to": "$patNext.A" },
        { "edit": "connect_pins", "from": "$patNext.ReturnValue", "to": "$patWrap.A" },
        { "edit": "connect_pins", "from": "$patCount.ReturnValue", "to": "$patWrap.B" },
        { "edit": "connect_pins", "from": "$patWrap.ReturnValue", "to": "$patSetIndex.PatrolIndex" },
        { "edit": "connect_pins", "from": "$patNow.ReturnValue", "to": "$patUntil.A" },
        { "edit": "connect_pins", "from": "$patWaitFor.PatrolWait", "to": "$patUntil.B" },
        { "edit": "connect_pins", "from": "$patUntil.ReturnValue", "to": "$patSetResume.PatrolResumeAt" },
        { "edit": "connect_pins", "from": "$patAI.AsAIController", "to": "$patGo.self" },
        { "edit": "connect_pins", "from": "$patTarget.ReturnValue", "to": "$patGo.Dest" },
        { "edit": "connect_pins", "from": "$patPath.UsePathfinding", "to": "$patGo.bUsePathfinding" },
        { "edit": "connect_pins", "from": "$patrol.then", "to": "$patAI.execute" },
        { "edit": "connect_pins", "from": "$patAI.then", "to": "$patChaseBranch.execute" },
        { "edit": "connect_pins", "from": "$patChaseBranch.then", "to": "$patFollow.execute" },
        { "edit": "connect_pins", "from": "$patChaseBranch.else", "to": "$patWaitBranch.execute" },
        { "edit": "connect_pins", "from": "$patWaitBranch.else", "to": "$patHasBranch.execute" },
        { "edit": "connect_pins", "from": "$patHasBranch.then", "to": "$patArrivedBranch.execute" },
        { "edit": "connect_pins", "from": "$patArrivedBranch.then", "to": "$patSetIndex.execute" },
        { "edit": "connect_pins", "from": "$patSetIndex.then", "to": "$patSetResume.execute" },
        { "edit": "connect_pins", "from": "$patArrivedBranch.else", "to": "$patGo.execute" }
      ]
    }
  ],
  "hooks": [
    { "id": "patBegin", "event": "BeginPlay" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "patStart", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "patSetOrigin", "nodeType": "VariableSet", "memberName": "PatrolOrigin" },
    { "edit": "create_node", "id": "patSelf", "nodeType": "Self" },
    { "edit": "create_node", "id": "patEvery", "nodeType": "VariableGet", "memberName": "PatrolInterval" },
    { "edit": "create_node", "id": "patTimer", "nodeType": "CallFunction", "memberName": "K2_SetTimer", "memberClass": "/Script/Engine.KismetSystemLibrary", "pinDefaults": { "FunctionName": "PatrolUpdate", "bLooping": true } },
    { "edit": "connect_pins", "from": "$patStart.ReturnValue", "to": "$patSetOrigin.PatrolOrigin" },
    { "edit": "connect_pins", "from": "$patSelf.self", "to": "$patTimer.Object" },
    { "edit": "connect_pins", "from": "$patEvery.PatrolInterval", "to": "$patTimer.Time" },
    { "edit": "connect_pins", "from": "$patBegin.then", "to": "$patSetOrigin.execute" },
    { "edit": "connect_pins", "from": "$patSetOrigin.then", "to": "$patTimer.execute" }
  ]
}
