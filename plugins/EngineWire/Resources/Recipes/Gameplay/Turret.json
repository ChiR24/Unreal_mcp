{
  "description": "A turret: every frame, while the player's pawn is within TurretRange, the actor turns about its vertical axis to face the player (its placed pitch and roll stay), and at most FireRate times a minute it spawns ProjectileClass MuzzleOffset units out from the centre of its colliding parts (its pivot when it has none, since a pivot at the base would fire into the ground) along the line to the player, owned by the actor (a projectile made by create_combat_asset never hits its owner), and launches it at the player at ProjectileSpeed. Nothing checks line of sight: a wall between them stops the shots.",
  "tag": "Turret",
  "placeholders": {
    "ProjectileType": "The ProjectileClass variable's type, Class: followed by a class path (any actor, or the narrower class the variable already holds).",
    "ProjectileClass": "The projectile Blueprint's generated class path.",
    "ProjectileSpeed": "Launch speed in units per second.",
    "FireRate": "Most shots a minute.",
    "Range": "Distance within which it turns to the player and fires, in units."
  },
  "variables": [
    { "variableName": "ProjectileClass", "variableType": "{{ProjectileType}}", "defaultValue": "{{ProjectileClass}}", "category": "Turret", "instanceEditable": true },
    { "variableName": "ProjectileSpeed", "variableType": "Float", "defaultValue": "{{ProjectileSpeed}}", "category": "Turret", "instanceEditable": true },
    { "variableName": "FireRate", "variableType": "Float", "defaultValue": "{{FireRate}}", "category": "Turret", "instanceEditable": true },
    { "variableName": "TurretRange", "variableType": "Float", "defaultValue": "{{Range}}", "category": "Turret", "instanceEditable": true },
    { "variableName": "MuzzleOffset", "variableType": "Float", "defaultValue": 100, "category": "Turret", "instanceEditable": true, "keepExisting": true },
    { "variableName": "LastShotTime", "variableType": "Float", "defaultValue": -1000, "category": "Turret" }
  ],
  "hooks": [
    { "id": "turretTick", "event": "Tick" }
  ],
  "eventGraph": [
