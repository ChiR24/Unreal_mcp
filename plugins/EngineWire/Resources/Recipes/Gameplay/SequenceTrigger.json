{
  "description": "A cutscene that plays when a player walks into the actor's area: when a pawn a local player controls starts to overlap the actor, a Level Sequence player is made for EnterSequence and played in the level, so the sequence's camera cuts take that player's view; with EnterSequenceOnce only the first time. With EnterSequenceCinematic the player's controller is in cinematic mode while it plays (no moving or turning, the HUD actor not drawn while widgets on the screen stay, the pawn still visible, since an in-level cutscene shows the place the player stands in) and leaves it, with the same flags, when the sequence finishes (OnFinished). Nothing starts for a pawn no player controls, while the cutscene still plays, or when EnterSequence is empty. The actor needs a component that overlaps pawns.",
  "tag": "SequenceTrigger",
  "placeholders": {
    "Sequence": "Object path of the Level Sequence to play.",
    "Once": "true plays it only the first time a player enters.",
    "Cinematic": "true puts the player in cinematic mode while it plays."
  },
  "variables": [
    { "variableName": "EnterSequence", "variableType": "Object:/Script/LevelSequence.LevelSequence", "defaultValue": "{{Sequence}}", "category": "Enter Sequence", "instanceEditable": true },
    { "variableName": "EnterSequenceOnce", "variableType": "Bool", "defaultValue": "{{Once}}", "category": "Enter Sequence", "instanceEditable": true },
    { "variableName": "EnterSequenceCinematic", "variableType": "Bool", "defaultValue": "{{Cinematic}}", "category": "Enter Sequence", "instanceEditable": true },
    { "variableName": "bEnterSequencePlayed", "variableType": "Bool", "defaultValue": false, "category": "Enter Sequence" },
    { "variableName": "bEnterSequencePlaying", "variableType": "Bool", "defaultValue": false, "category": "Enter Sequence" },
    { "variableName": "EnterSequenceController", "variableType": "Object:/Script/Engine.PlayerController", "category": "Enter Sequence" }
  ],
  "hooks": [
    { "id": "seqEnter", "event": "ActorBeginOverlap" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "seqWho", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "seqController", "nodeType": "CallFunction", "memberName": "GetController", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "seqPlayer", "nodeType": "Cast", "targetClass": "/Script/Engine.PlayerController" },
    { "edit": "create_node", "id": "seqLocal", "nodeType": "CallFunction", "memberName": "IsLocallyControlled", "memberClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "seqAsset", "nodeType": "VariableGet", "memberName": "EnterSequence" },
    { "edit": "create_node", "id": "seqHasAsset", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "seqOnce", "nodeType": "VariableGet", "memberName": "EnterSequenceOnce" },
    { "edit": "create_node", "id": "seqPlayed", "nodeType": "VariableGet", "memberName": "bEnterSequencePlayed" },
    { "edit": "create_node", "id": "seqSpent", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "seqPlaying", "nodeType": "VariableGet", "memberName": "bEnterSequencePlaying" },
    { "edit": "create_node", "id": "seqBusy", "nodeType": "CallFunction", "memberName": "BooleanOR", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "seqFree", "nodeType": "CallFunction", "memberName": "Not_PreBool", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "seqLocalFree", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "seqReady", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "seqGo", "nodeType": "Branch" },
    { "edit": "create_node", "id": "seqMark", "nodeType": "VariableSet", "memberName": "bEnterSequencePlayed", "pinDefaults": { "bEnterSequencePlayed": true } },
    { "edit": "create_node", "id": "seqStart", "nodeType": "VariableSet", "memberName": "bEnterSequencePlaying", "pinDefaults": { "bEnterSequencePlaying": true } },
    { "edit": "create_node", "id": "seqCreate", "nodeType": "CallFunction", "memberName": "CreateLevelSequencePlayer", "memberClass": "/Script/LevelSequence.LevelSequencePlayer" },
    { "edit": "create_node", "id": "seqBind", "nodeType": "BindEvent", "memberName": "OnFinished", "memberClass": "/Script/MovieScene.MovieSceneSequencePlayer", "eventName": "OnEnterSequenceFinished" },
    { "edit": "create_node", "id": "seqCinematic", "nodeType": "VariableGet", "memberName": "EnterSequenceCinematic" },
    { "edit": "create_node", "id": "seqHow", "nodeType": "Branch" },
    { "edit": "create_node", "id": "seqKeep", "nodeType": "VariableSet", "memberName": "EnterSequenceController" },
    { "edit": "create_node", "id": "seqFreeze", "nodeType": "CallFunction", "memberName": "SetCinematicMode", "memberClass": "/Script/Engine.PlayerController", "pinDefaults": { "bInCinematicMode": true, "bHidePlayer": false, "bAffectsHUD": true, "bAffectsMovement": true, "bAffectsTurning": true } },
    { "edit": "create_node", "id": "seqPlay", "nodeType": "CallFunction", "memberName": "Play", "memberClass": "/Script/MovieScene.MovieSceneSequencePlayer" },
    { "edit": "connect_pins", "from": "$seqEnter_event.OtherActor", "to": "$seqWho.Object" },
    { "edit": "connect_pins", "from": "$seqWho.AsPawn", "to": "$seqController.self" },
    { "edit": "connect_pins", "from": "$seqController.ReturnValue", "to": "$seqPlayer.Object" },
    { "edit": "connect_pins", "from": "$seqWho.AsPawn", "to": "$seqLocal.self" },
    { "edit": "connect_pins", "from": "$seqAsset.EnterSequence", "to": "$seqHasAsset.Object" },
    { "edit": "connect_pins", "from": "$seqOnce.EnterSequenceOnce", "to": "$seqSpent.A" },
    { "edit": "connect_pins", "from": "$seqPlayed.bEnterSequencePlayed", "to": "$seqSpent.B" },
    { "edit": "connect_pins", "from": "$seqSpent.ReturnValue", "to": "$seqBusy.A" },
    { "edit": "connect_pins", "from": "$seqPlaying.bEnterSequencePlaying", "to": "$seqBusy.B" },
    { "edit": "connect_pins", "from": "$seqBusy.ReturnValue", "to": "$seqFree.A" },
    { "edit": "connect_pins", "from": "$seqLocal.ReturnValue", "to": "$seqLocalFree.A" },
    { "edit": "connect_pins", "from": "$seqFree.ReturnValue", "to": "$seqLocalFree.B" },
    { "edit": "connect_pins", "from": "$seqLocalFree.ReturnValue", "to": "$seqReady.A" },
    { "edit": "connect_pins", "from": "$seqHasAsset.ReturnValue", "to": "$seqReady.B" },
    { "edit": "connect_pins", "from": "$seqReady.ReturnValue", "to": "$seqGo.Condition" },
    { "edit": "connect_pins", "from": "$seqAsset.EnterSequence", "to": "$seqCreate.LevelSequence" },
    { "edit": "connect_pins", "from": "$seqCreate.ReturnValue", "to": "$seqBind.self" },
    { "edit": "connect_pins", "from": "$seqCinematic.EnterSequenceCinematic", "to": "$seqHow.Condition" },
    { "edit": "connect_pins", "from": "$seqPlayer.AsPlayer Controller", "to": "$seqKeep.EnterSequenceController" },
    { "edit": "connect_pins", "from": "$seqPlayer.AsPlayer Controller", "to": "$seqFreeze.self" },
    { "edit": "connect_pins", "from": "$seqCreate.ReturnValue", "to": "$seqPlay.self" },
    { "edit": "connect_pins", "from": "$seqEnter.then", "to": "$seqWho.execute" },
    { "edit": "connect_pins", "from": "$seqWho.then", "to": "$seqPlayer.execute" },
    { "edit": "connect_pins", "from": "$seqPlayer.then", "to": "$seqGo.execute" },
    { "edit": "connect_pins", "from": "$seqGo.then", "to": "$seqMark.execute" },
    { "edit": "connect_pins", "from": "$seqMark.then", "to": "$seqStart.execute" },
    { "edit": "connect_pins", "from": "$seqStart.then", "to": "$seqCreate.execute" },
    { "edit": "connect_pins", "from": "$seqCreate.then", "to": "$seqBind.execute" },
    { "edit": "connect_pins", "from": "$seqBind.then", "to": "$seqHow.execute" },
    { "edit": "connect_pins", "from": "$seqHow.then", "to": "$seqKeep.execute" },
    { "edit": "connect_pins", "from": "$seqKeep.then", "to": "$seqFreeze.execute" },
    { "edit": "connect_pins", "from": "$seqFreeze.then", "to": "$seqPlay.execute" },
    { "edit": "connect_pins", "from": "$seqHow.else", "to": "$seqPlay.execute" },

    { "edit": "create_node", "id": "doneIdle", "nodeType": "VariableSet", "memberName": "bEnterSequencePlaying", "pinDefaults": { "bEnterSequencePlaying": false } },
    { "edit": "create_node", "id": "doneController", "nodeType": "VariableGet", "memberName": "EnterSequenceController" },
    { "edit": "create_node", "id": "doneHasController", "nodeType": "CallFunction", "memberName": "IsValid", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "doneIf", "nodeType": "Branch" },
    { "edit": "create_node", "id": "doneThaw", "nodeType": "CallFunction", "memberName": "SetCinematicMode", "memberClass": "/Script/Engine.PlayerController", "pinDefaults": { "bInCinematicMode": false, "bHidePlayer": false, "bAffectsHUD": true, "bAffectsMovement": true, "bAffectsTurning": true } },
    { "edit": "create_node", "id": "doneForget", "nodeType": "VariableSet", "memberName": "EnterSequenceController" },
    { "edit": "connect_pins", "from": "$doneController.EnterSequenceController", "to": "$doneHasController.Object" },
    { "edit": "connect_pins", "from": "$doneHasController.ReturnValue", "to": "$doneIf.Condition" },
    { "edit": "connect_pins", "from": "$doneController.EnterSequenceController", "to": "$doneThaw.self" },
    { "edit": "connect_pins", "from": "$seqBind_event.then", "to": "$doneIdle.execute" },
    { "edit": "connect_pins", "from": "$doneIdle.then", "to": "$doneIf.execute" },
    { "edit": "connect_pins", "from": "$doneIf.then", "to": "$doneThaw.execute" },
    { "edit": "connect_pins", "from": "$doneThaw.then", "to": "$doneForget.execute" }
  ]
}
