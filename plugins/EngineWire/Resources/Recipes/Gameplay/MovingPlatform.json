{
  "description": "A moving platform or elevator: every frame it travels at PlatformSpeed toward PlatformOrigin + PlatformPoints[PlatformIndex] (the points are offsets from where it starts), and on arriving it waits PlatformWait seconds and heads for the next point, looping. A Character standing on it rides along. It moves itself, so its root must be movable.",
  "tag": "MovingPlatform",
  "placeholders": {
    "Points": "The route as an array of vector offsets from where the actor starts.",
    "Speed": "Units per second it travels.",
    "Wait": "Seconds it waits at each point."
  },
  "variables": [
    { "variableName": "PlatformPoints", "variableType": "Array:Vector", "defaultValue": "{{Points}}", "category": "Moving Platform", "instanceEditable": true },
    { "variableName": "PlatformSpeed", "variableType": "Float", "defaultValue": "{{Speed}}", "category": "Moving Platform", "instanceEditable": true },
    { "variableName": "PlatformWait", "variableType": "Float", "defaultValue": "{{Wait}}", "category": "Moving Platform", "instanceEditable": true },
    { "variableName": "PlatformOrigin", "variableType": "Vector", "category": "Moving Platform" },
    { "variableName": "PlatformIndex", "variableType": "Int", "defaultValue": 0, "category": "Moving Platform" },
    { "variableName": "PlatformResumeAt", "variableType": "Float", "defaultValue": 0, "category": "Moving Platform" }
  ],
  "hooks": [
    { "id": "mpBegin", "event": "BeginPlay" },
    { "id": "mpTick", "event": "Tick" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "mpHere", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "mpRemember", "nodeType": "VariableSet", "memberName": "PlatformOrigin" },
    { "edit": "connect_pins", "from": "$mpHere.ReturnValue", "to": "$mpRemember.PlatformOrigin" },
    { "edit": "connect_pins", "from": "$mpBegin.then", "to": "$mpRemember.execute" },

    { "edit": "create_node", "id": "mpPoints", "nodeType": "VariableGet", "memberName": "PlatformPoints" },
    { "edit": "create_node", "id": "mpCount", "nodeType": "CallFunction", "memberName": "Array_Length", "memberClass": "/Script/Engine.KismetArrayLibrary" },
    { "edit": "create_node", "id": "mpHas", "nodeType": "CallFunction", "memberName": "Greater_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "mpNow", "nodeType": "CallFunction", "memberName": "GetGameTimeInSeconds", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "mpResume", "nodeType": "VariableGet", "memberName": "PlatformResumeAt" },
    { "edit": "create_node", "id": "mpReady", "nodeType": "CallFunction", "memberName": "GreaterEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpGo", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "mpIndex", "nodeType": "VariableGet", "memberName": "PlatformIndex" },
    { "edit": "create_node", "id": "mpItem", "nodeType": "CallFunction", "memberName": "Array_Get", "memberClass": "/Script/Engine.KismetArrayLibrary" },
    { "edit": "create_node", "id": "mpOrigin", "nodeType": "VariableGet", "memberName": "PlatformOrigin" },
    { "edit": "create_node", "id": "mpTarget", "nodeType": "CallFunction", "memberName": "Add_VectorVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpHereNow", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "mpSpeed", "nodeType": "VariableGet", "memberName": "PlatformSpeed" },
    { "edit": "create_node", "id": "mpStep", "nodeType": "CallFunction", "memberName": "VInterpTo_Constant", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpMove", "nodeType": "CallFunction", "memberName": "K2_SetActorLocation", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "bSweep": false, "bTeleport": false } },
    { "edit": "create_node", "id": "mpGap", "nodeType": "CallFunction", "memberName": "Vector_Distance", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpArrived", "nodeType": "CallFunction", "memberName": "Less_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0.5 } },
    { "edit": "create_node", "id": "mpArrivedBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "mpNext", "nodeType": "CallFunction", "memberName": "Add_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
    { "edit": "create_node", "id": "mpWrap", "nodeType": "CallFunction", "memberName": "Percent_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpSetIndex", "nodeType": "VariableSet", "memberName": "PlatformIndex" },
    { "edit": "create_node", "id": "mpWait", "nodeType": "VariableGet", "memberName": "PlatformWait" },
    { "edit": "create_node", "id": "mpUntil", "nodeType": "CallFunction", "memberName": "Add_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "mpSetResume", "nodeType": "VariableSet", "memberName": "PlatformResumeAt" },
    { "edit": "connect_pins", "from": "$mpPoints.PlatformPoints", "to": "$mpCount.TargetArray" },
    { "edit": "connect_pins", "from": "$mpCount.ReturnValue", "to": "$mpHas.A" },
    { "edit": "connect_pins", "from": "$mpNow.ReturnValue", "to": "$mpReady.A" },
    { "edit": "connect_pins", "from": "$mpResume.PlatformResumeAt", "to": "$mpReady.B" },
    { "edit": "connect_pins", "from": "$mpHas.ReturnValue", "to": "$mpGo.A" },
    { "edit": "connect_pins", "from": "$mpReady.ReturnValue", "to": "$mpGo.B" },
    { "edit": "connect_pins", "from": "$mpGo.ReturnValue", "to": "$mpBranch.Condition" },
    { "edit": "connect_pins", "from": "$mpPoints.PlatformPoints", "to": "$mpItem.TargetArray" },
    { "edit": "connect_pins", "from": "$mpIndex.PlatformIndex", "to": "$mpItem.Index" },
    { "edit": "connect_pins", "from": "$mpOrigin.PlatformOrigin", "to": "$mpTarget.A" },
    { "edit": "connect_pins", "from": "$mpItem.Item", "to": "$mpTarget.B" },
    { "edit": "connect_pins", "from": "$mpHereNow.ReturnValue", "to": "$mpStep.Current" },
    { "edit": "connect_pins", "from": "$mpTarget.ReturnValue", "to": "$mpStep.Target" },
    { "edit": "connect_pins", "from": "$mpTick_event.DeltaSeconds", "to": "$mpStep.DeltaTime" },
    { "edit": "connect_pins", "from": "$mpSpeed.PlatformSpeed", "to": "$mpStep.InterpSpeed" },
    { "edit": "connect_pins", "from": "$mpStep.ReturnValue", "to": "$mpMove.NewLocation" },
    { "edit": "connect_pins", "from": "$mpStep.ReturnValue", "to": "$mpGap.V1" },
    { "edit": "connect_pins", "from": "$mpTarget.ReturnValue", "to": "$mpGap.V2" },
    { "edit": "connect_pins", "from": "$mpGap.ReturnValue", "to": "$mpArrived.A" },
    { "edit": "connect_pins", "from": "$mpArrived.ReturnValue", "to": "$mpArrivedBranch.Condition" },
    { "edit": "connect_pins", "from": "$mpIndex.PlatformIndex", "to": "$mpNext.A" },
    { "edit": "connect_pins", "from": "$mpNext.ReturnValue", "to": "$mpWrap.A" },
    { "edit": "connect_pins", "from": "$mpCount.ReturnValue", "to": "$mpWrap.B" },
    { "edit": "connect_pins", "from": "$mpWrap.ReturnValue", "to": "$mpSetIndex.PlatformIndex" },
    { "edit": "connect_pins", "from": "$mpNow.ReturnValue", "to": "$mpUntil.A" },
    { "edit": "connect_pins", "from": "$mpWait.PlatformWait", "to": "$mpUntil.B" },
    { "edit": "connect_pins", "from": "$mpUntil.ReturnValue", "to": "$mpSetResume.PlatformResumeAt" },
    { "edit": "connect_pins", "from": "$mpTick.then", "to": "$mpBranch.execute" },
    { "edit": "connect_pins", "from": "$mpBranch.then", "to": "$mpMove.execute" },
    { "edit": "connect_pins", "from": "$mpMove.then", "to": "$mpArrivedBranch.execute" },
    { "edit": "connect_pins", "from": "$mpArrivedBranch.then", "to": "$mpSetIndex.execute" },
    { "edit": "connect_pins", "from": "$mpSetIndex.then", "to": "$mpSetResume.execute" }
  ]
}
