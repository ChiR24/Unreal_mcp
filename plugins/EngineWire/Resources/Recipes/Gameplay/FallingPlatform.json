{
  "description": "A platform that falls: the first pawn that lands on top of it (a Hit whose normal points down at the platform; a bump from the side or below does not count) starts it shaking, FallDelay seconds later it drops with gravity, and RespawnTime seconds after the drop began it is back where it started, ready again; with RespawnTime 0 it never comes back and is destroyed 5 seconds into its fall. It moves itself, so its root must be movable.",
  "tag": "FallingPlatform",
  "placeholders": {
    "Delay": "Seconds it shakes before it falls.",
    "Respawn": "Seconds after it starts to fall until it is back in place; 0 never."
  },
  "variables": [
    { "variableName": "FallDelay", "variableType": "Float", "defaultValue": "{{Delay}}", "category": "Falling Platform", "instanceEditable": true },
    { "variableName": "RespawnTime", "variableType": "Float", "defaultValue": "{{Respawn}}", "category": "Falling Platform", "instanceEditable": true },
    { "variableName": "PlatformStart", "variableType": "Vector", "category": "Falling Platform" },
    { "variableName": "FallSpeed", "variableType": "Float", "defaultValue": 0, "category": "Falling Platform" },
    { "variableName": "bPlatformShaking", "variableType": "Bool", "defaultValue": false, "category": "Falling Platform" },
    { "variableName": "bPlatformFalling", "variableType": "Bool", "defaultValue": false, "category": "Falling Platform" }
  ],
  "functions": [
    {
      "id": "fpFall",
      "functionName": "PlatformFall",
      "operations": [
        { "edit": "create_node", "id": "fpFallStart", "nodeType": "VariableGet", "memberName": "PlatformStart" },
        { "edit": "create_node", "id": "fpFallPlace", "nodeType": "CallFunction", "memberName": "K2_SetActorLocation", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "bSweep": false, "bTeleport": true } },
        { "edit": "create_node", "id": "fpFallShakeOff", "nodeType": "VariableSet", "memberName": "bPlatformShaking", "pinDefaults": { "bPlatformShaking": false } },
        { "edit": "create_node", "id": "fpFallOn", "nodeType": "VariableSet", "memberName": "bPlatformFalling", "pinDefaults": { "bPlatformFalling": true } },
        { "edit": "create_node", "id": "fpFallZero", "nodeType": "VariableSet", "memberName": "FallSpeed", "pinDefaults": { "FallSpeed": 0 } },
        { "edit": "create_node", "id": "fpFallBack", "nodeType": "VariableGet", "memberName": "RespawnTime" },
        { "edit": "create_node", "id": "fpFallReturns", "nodeType": "CallFunction", "memberName": "Greater_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
        { "edit": "create_node", "id": "fpFallBranch", "nodeType": "Branch" },
        { "edit": "create_node", "id": "fpFallSelf", "nodeType": "Self" },
        { "edit": "create_node", "id": "fpFallTimer", "nodeType": "CallFunction", "memberName": "K2_SetTimer", "memberClass": "/Script/Engine.KismetSystemLibrary", "pinDefaults": { "FunctionName": "PlatformReturn", "bLooping": false } },
        { "edit": "create_node", "id": "fpFallGone", "nodeType": "CallFunction", "memberName": "SetLifeSpan", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "InLifespan": 5 } },
        { "edit": "connect_pins", "from": "$fpFallStart.PlatformStart", "to": "$fpFallPlace.NewLocation" },
        { "edit": "connect_pins", "from": "$fpFallBack.RespawnTime", "to": "$fpFallReturns.A" },
        { "edit": "connect_pins", "from": "$fpFallReturns.ReturnValue", "to": "$fpFallBranch.Condition" },
        { "edit": "connect_pins", "from": "$fpFallSelf.self", "to": "$fpFallTimer.Object" },
        { "edit": "connect_pins", "from": "$fpFallBack.RespawnTime", "to": "$fpFallTimer.Time" },
        { "edit": "connect_pins", "from": "$fpFall.then", "to": "$fpFallPlace.execute" },
        { "edit": "connect_pins", "from": "$fpFallPlace.then", "to": "$fpFallShakeOff.execute" },
        { "edit": "connect_pins", "from": "$fpFallShakeOff.then", "to": "$fpFallOn.execute" },
        { "edit": "connect_pins", "from": "$fpFallOn.then", "to": "$fpFallZero.execute" },
        { "edit": "connect_pins", "from": "$fpFallZero.then", "to": "$fpFallBranch.execute" },
        { "edit": "connect_pins", "from": "$fpFallBranch.then", "to": "$fpFallTimer.execute" },
        { "edit": "connect_pins", "from": "$fpFallBranch.else", "to": "$fpFallGone.execute" }
      ]
    },
    {
      "id": "fpBack",
      "functionName": "PlatformReturn",
      "operations": [
        { "edit": "create_node", "id": "fpBackOff", "nodeType": "VariableSet", "memberName": "bPlatformFalling", "pinDefaults": { "bPlatformFalling": false } },
        { "edit": "create_node", "id": "fpBackStart", "nodeType": "VariableGet", "memberName": "PlatformStart" },
        { "edit": "create_node", "id": "fpBackPlace", "nodeType": "CallFunction", "memberName": "K2_SetActorLocation", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "bSweep": false, "bTeleport": true } },
        { "edit": "connect_pins", "from": "$fpBackStart.PlatformStart", "to": "$fpBackPlace.NewLocation" },
        { "edit": "connect_pins", "from": "$fpBack.then", "to": "$fpBackOff.execute" },
        { "edit": "connect_pins", "from": "$fpBackOff.then", "to": "$fpBackPlace.execute" }
      ]
    }
  ],
  "hooks": [
    { "id": "fpBegin", "event": "BeginPlay" },
    { "id": "fpHit", "event": "Hit" },
    { "id": "fpTick", "event": "Tick" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "fpHere", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "fpRemember", "nodeType": "VariableSet", "memberName": "PlatformStart" },
    { "edit": "connect_pins", "from": "$fpHere.ReturnValue", "to": "$fpRemember.PlatformStart" },
    { "edit": "connect_pins", "from": "$fpBegin.then", "to": "$fpRemember.execute" },

    { "edit": "create_node", "id": "fpWho", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "fpNormal", "nodeType": "CallFunction", "memberName": "BreakVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpOnTop", "nodeType": "CallFunction", "memberName": "Less_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": -0.7 } },
    { "edit": "create_node", "id": "fpShakingGet", "nodeType": "VariableGet", "memberName": "bPlatformShaking" },
    { "edit": "create_node", "id": "fpFallingGet", "nodeType": "VariableGet", "memberName": "bPlatformFalling" },
    { "edit": "create_node", "id": "fpBusy", "nodeType": "CallFunction", "memberName": "BooleanOR", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpIdle", "nodeType": "CallFunction", "memberName": "Not_PreBool", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpGo", "nodeType": "CallFunction", "memberName": "BooleanAND", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpGoBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "fpShakeOn", "nodeType": "VariableSet", "memberName": "bPlatformShaking", "pinDefaults": { "bPlatformShaking": true } },
    { "edit": "create_node", "id": "fpDelay", "nodeType": "VariableGet", "memberName": "FallDelay" },
    { "edit": "create_node", "id": "fpDelayFloor", "nodeType": "CallFunction", "memberName": "FMax", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0.01 } },
    { "edit": "create_node", "id": "fpHitSelf", "nodeType": "Self" },
    { "edit": "create_node", "id": "fpFallTimerStart", "nodeType": "CallFunction", "memberName": "K2_SetTimer", "memberClass": "/Script/Engine.KismetSystemLibrary", "pinDefaults": { "FunctionName": "PlatformFall", "bLooping": false } },
    { "edit": "connect_pins", "from": "$fpHit_event.Other", "to": "$fpWho.Object" },
    { "edit": "connect_pins", "from": "$fpHit_event.HitNormal", "to": "$fpNormal.InVec" },
    { "edit": "connect_pins", "from": "$fpNormal.Z", "to": "$fpOnTop.A" },
    { "edit": "connect_pins", "from": "$fpShakingGet.bPlatformShaking", "to": "$fpBusy.A" },
    { "edit": "connect_pins", "from": "$fpFallingGet.bPlatformFalling", "to": "$fpBusy.B" },
    { "edit": "connect_pins", "from": "$fpBusy.ReturnValue", "to": "$fpIdle.A" },
    { "edit": "connect_pins", "from": "$fpOnTop.ReturnValue", "to": "$fpGo.A" },
    { "edit": "connect_pins", "from": "$fpIdle.ReturnValue", "to": "$fpGo.B" },
    { "edit": "connect_pins", "from": "$fpGo.ReturnValue", "to": "$fpGoBranch.Condition" },
    { "edit": "connect_pins", "from": "$fpDelay.FallDelay", "to": "$fpDelayFloor.A" },
    { "edit": "connect_pins", "from": "$fpHitSelf.self", "to": "$fpFallTimerStart.Object" },
    { "edit": "connect_pins", "from": "$fpDelayFloor.ReturnValue", "to": "$fpFallTimerStart.Time" },
    { "edit": "connect_pins", "from": "$fpHit.then", "to": "$fpWho.execute" },
    { "edit": "connect_pins", "from": "$fpWho.then", "to": "$fpGoBranch.execute" },
    { "edit": "connect_pins", "from": "$fpGoBranch.then", "to": "$fpShakeOn.execute" },
    { "edit": "connect_pins", "from": "$fpShakeOn.then", "to": "$fpFallTimerStart.execute" },

    { "edit": "create_node", "id": "fpFallingTick", "nodeType": "VariableGet", "memberName": "bPlatformFalling" },
    { "edit": "create_node", "id": "fpTickBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "fpSpeed", "nodeType": "VariableGet", "memberName": "FallSpeed" },
    { "edit": "create_node", "id": "fpPull", "nodeType": "CallFunction", "memberName": "Multiply_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 980 } },
    { "edit": "create_node", "id": "fpFaster", "nodeType": "CallFunction", "memberName": "Add_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpSpeedSet", "nodeType": "VariableSet", "memberName": "FallSpeed" },
    { "edit": "create_node", "id": "fpStep", "nodeType": "CallFunction", "memberName": "Multiply_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpDown", "nodeType": "CallFunction", "memberName": "Multiply_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": -1 } },
    { "edit": "create_node", "id": "fpDrop", "nodeType": "CallFunction", "memberName": "MakeVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpMove", "nodeType": "CallFunction", "memberName": "K2_AddActorWorldOffset", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "bSweep": false, "bTeleport": false } },
    { "edit": "create_node", "id": "fpShakingTick", "nodeType": "VariableGet", "memberName": "bPlatformShaking" },
    { "edit": "create_node", "id": "fpShakeBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "fpJitterX", "nodeType": "CallFunction", "memberName": "RandomFloatInRange", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "Min": -3, "Max": 3 } },
    { "edit": "create_node", "id": "fpJitterY", "nodeType": "CallFunction", "memberName": "RandomFloatInRange", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "Min": -3, "Max": 3 } },
    { "edit": "create_node", "id": "fpJitter", "nodeType": "CallFunction", "memberName": "MakeVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpStartTick", "nodeType": "VariableGet", "memberName": "PlatformStart" },
    { "edit": "create_node", "id": "fpShakeAt", "nodeType": "CallFunction", "memberName": "Add_VectorVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "fpShake", "nodeType": "CallFunction", "memberName": "K2_SetActorLocation", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "bSweep": false, "bTeleport": true } },
    { "edit": "connect_pins", "from": "$fpFallingTick.bPlatformFalling", "to": "$fpTickBranch.Condition" },
    { "edit": "connect_pins", "from": "$fpTick_event.DeltaSeconds", "to": "$fpPull.A" },
    { "edit": "connect_pins", "from": "$fpSpeed.FallSpeed", "to": "$fpFaster.A" },
    { "edit": "connect_pins", "from": "$fpPull.ReturnValue", "to": "$fpFaster.B" },
    { "edit": "connect_pins", "from": "$fpFaster.ReturnValue", "to": "$fpSpeedSet.FallSpeed" },
    { "edit": "connect_pins", "from": "$fpSpeedSet.Output_Get", "to": "$fpStep.A" },
    { "edit": "connect_pins", "from": "$fpTick_event.DeltaSeconds", "to": "$fpStep.B" },
    { "edit": "connect_pins", "from": "$fpStep.ReturnValue", "to": "$fpDown.A" },
    { "edit": "connect_pins", "from": "$fpDown.ReturnValue", "to": "$fpDrop.Z" },
    { "edit": "connect_pins", "from": "$fpDrop.ReturnValue", "to": "$fpMove.DeltaLocation" },
    { "edit": "connect_pins", "from": "$fpShakingTick.bPlatformShaking", "to": "$fpShakeBranch.Condition" },
    { "edit": "connect_pins", "from": "$fpJitterX.ReturnValue", "to": "$fpJitter.X" },
    { "edit": "connect_pins", "from": "$fpJitterY.ReturnValue", "to": "$fpJitter.Y" },
    { "edit": "connect_pins", "from": "$fpStartTick.PlatformStart", "to": "$fpShakeAt.A" },
    { "edit": "connect_pins", "from": "$fpJitter.ReturnValue", "to": "$fpShakeAt.B" },
    { "edit": "connect_pins", "from": "$fpShakeAt.ReturnValue", "to": "$fpShake.NewLocation" },
    { "edit": "connect_pins", "from": "$fpTick.then", "to": "$fpTickBranch.execute" },
    { "edit": "connect_pins", "from": "$fpTickBranch.then", "to": "$fpSpeedSet.execute" },
    { "edit": "connect_pins", "from": "$fpSpeedSet.then", "to": "$fpMove.execute" },
    { "edit": "connect_pins", "from": "$fpTickBranch.else", "to": "$fpShakeBranch.execute" },
    { "edit": "connect_pins", "from": "$fpShakeBranch.then", "to": "$fpShake.execute" }
  ]
}
