{
  "description": "Shooting for a pawn: each press of the key spawns ProjectileClass MuzzleOffset units in front of the pawn, facing where the pawn faces, owned and instigated by the pawn (a projectile made by create_combat_asset never hits its shooter), and launches it forward at ProjectileSpeed; presses closer together than 60 / FireRate seconds do nothing. The key gets its own Input Action and mapping, registered when the pawn is possessed.",
  "tag": "Shoot",
  "placeholders": {
    "Key": "Key pressed to shoot, e.g. LeftMouseButton.",
    "ProjectileType": "The ProjectileClass variable's type, Class: followed by a class path (any actor, or the narrower class the variable already holds).",
    "ProjectileClass": "The projectile Blueprint's generated class path.",
    "ProjectileSpeed": "Launch speed in units per second.",
    "FireRate": "Most shots a minute.",
    "InputAction": "Input Action asset to use, or empty for IA_Shoot next to the Blueprint.",
    "MappingContext": "Input Mapping Context the key goes in, or empty for the one the pawn registers (else /Game/Input/IMC_MCP)."
  },
  "variables": [
    { "variableName": "ProjectileClass", "variableType": "{{ProjectileType}}", "defaultValue": "{{ProjectileClass}}", "category": "Shoot", "instanceEditable": true },
    { "variableName": "ProjectileSpeed", "variableType": "Float", "defaultValue": "{{ProjectileSpeed}}", "category": "Shoot", "instanceEditable": true },
    { "variableName": "FireRate", "variableType": "Float", "defaultValue": "{{FireRate}}", "category": "Shoot", "instanceEditable": true },
    { "variableName": "MuzzleOffset", "variableType": "Float", "defaultValue": 100, "category": "Shoot", "instanceEditable": true, "keepExisting": true },
    { "variableName": "LastShotTime", "variableType": "Float", "defaultValue": -1000, "category": "Shoot" }
  ],
  "input": { "id": "shootInput", "key": "{{Key}}", "inputActionPath": "{{InputAction}}", "mappingContextPath": "{{MappingContext}}" },
  "eventGraph": [
    { "edit": "create_node", "id": "shootNow", "nodeType": "CallFunction", "memberName": "GetGameTimeInSeconds", "memberClass": "/Script/Engine.KismetSystemLibrary" },
    { "edit": "create_node", "id": "shootLast", "nodeType": "VariableGet", "memberName": "LastShotTime" },
    { "edit": "create_node", "id": "shootSince", "nodeType": "CallFunction", "memberName": "Subtract_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootRate", "nodeType": "VariableGet", "memberName": "FireRate" },
    { "edit": "create_node", "id": "shootRateFloor", "nodeType": "CallFunction", "memberName": "FMax", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
    { "edit": "create_node", "id": "shootGap", "nodeType": "CallFunction", "memberName": "Divide_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "A": 60 } },
    { "edit": "create_node", "id": "shootReady", "nodeType": "CallFunction", "memberName": "GreaterEqual_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "shootStamp", "nodeType": "VariableSet", "memberName": "LastShotTime" },
    { "edit": "create_node", "id": "shootFrom", "nodeType": "CallFunction", "memberName": "K2_GetActorLocation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "shootAhead", "nodeType": "CallFunction", "memberName": "GetActorForwardVector", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "shootOffset", "nodeType": "VariableGet", "memberName": "MuzzleOffset" },
    { "edit": "create_node", "id": "shootReach", "nodeType": "CallFunction", "memberName": "Multiply_VectorFloat", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootMuzzle", "nodeType": "CallFunction", "memberName": "Add_VectorVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootFacing", "nodeType": "CallFunction", "memberName": "K2_GetActorRotation", "memberClass": "/Script/Engine.Actor" },
    { "edit": "create_node", "id": "shootPlace", "nodeType": "CallFunction", "memberName": "MakeTransform", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootClass", "nodeType": "VariableGet", "memberName": "ProjectileClass" },
    { "edit": "create_node", "id": "shootSelf", "nodeType": "Self" },
    { "edit": "create_node", "id": "shootSpawn", "nodeType": "SpawnActorFromClass", "pinDefaults": { "CollisionHandlingOverride": "AlwaysSpawn" } },
    { "edit": "create_node", "id": "shootMover", "nodeType": "CallFunction", "memberName": "GetComponentByClass", "memberClass": "/Script/Engine.Actor", "pinDefaults": { "ComponentClass": "/Script/Engine.ProjectileMovementComponent" } },
    { "edit": "create_node", "id": "shootSpeed", "nodeType": "VariableGet", "memberName": "ProjectileSpeed" },
    { "edit": "create_node", "id": "shootForward", "nodeType": "CallFunction", "memberName": "MakeVector", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "shootLaunch", "nodeType": "CallFunction", "memberName": "SetVelocityInLocalSpace", "memberClass": "/Script/Engine.ProjectileMovementComponent" },
    { "edit": "connect_pins", "from": "$shootNow.ReturnValue", "to": "$shootSince.A" },
    { "edit": "connect_pins", "from": "$shootLast.LastShotTime", "to": "$shootSince.B" },
    { "edit": "connect_pins", "from": "$shootRate.FireRate", "to": "$shootRateFloor.A" },
    { "edit": "connect_pins", "from": "$shootRateFloor.ReturnValue", "to": "$shootGap.B" },
    { "edit": "connect_pins", "from": "$shootSince.ReturnValue", "to": "$shootReady.A" },
    { "edit": "connect_pins", "from": "$shootGap.ReturnValue", "to": "$shootReady.B" },
    { "edit": "connect_pins", "from": "$shootReady.ReturnValue", "to": "$shootBranch.Condition" },
    { "edit": "connect_pins", "from": "$shootNow.ReturnValue", "to": "$shootStamp.LastShotTime" },
    { "edit": "connect_pins", "from": "$shootAhead.ReturnValue", "to": "$shootReach.A" },
    { "edit": "connect_pins", "from": "$shootOffset.MuzzleOffset", "to": "$shootReach.B" },
    { "edit": "connect_pins", "from": "$shootFrom.ReturnValue", "to": "$shootMuzzle.A" },
    { "edit": "connect_pins", "from": "$shootReach.ReturnValue", "to": "$shootMuzzle.B" },
    { "edit": "connect_pins", "from": "$shootMuzzle.ReturnValue", "to": "$shootPlace.Location" },
    { "edit": "connect_pins", "from": "$shootFacing.ReturnValue", "to": "$shootPlace.Rotation" },
    { "edit": "connect_pins", "from": "$shootClass.ProjectileClass", "to": "$shootSpawn.Class" },
    { "edit": "connect_pins", "from": "$shootPlace.ReturnValue", "to": "$shootSpawn.SpawnTransform" },
    { "edit": "connect_pins", "from": "$shootSelf.self", "to": "$shootSpawn.Owner" },
    { "edit": "connect_pins", "from": "$shootSelf.self", "to": "$shootSpawn.Instigator" },
    { "edit": "connect_pins", "from": "$shootSpawn.ReturnValue", "to": "$shootMover.self" },
    { "edit": "connect_pins", "from": "$shootSpeed.ProjectileSpeed", "to": "$shootForward.X" },
    { "edit": "connect_pins", "from": "$shootMover.ReturnValue", "to": "$shootLaunch.self" },
    { "edit": "connect_pins", "from": "$shootForward.ReturnValue", "to": "$shootLaunch.NewVelocity" },
    { "edit": "connect_pins", "from": "$shootInput.Started", "to": "$shootBranch.execute" },
    { "edit": "connect_pins", "from": "$shootBranch.then", "to": "$shootStamp.execute" },
    { "edit": "connect_pins", "from": "$shootStamp.then", "to": "$shootSpawn.execute" },
    { "edit": "connect_pins", "from": "$shootSpawn.then", "to": "$shootLaunch.execute" }
  ]
}
