{
  "description": "Opens a door or a chest lid when a pawn comes near: while a pawn overlaps the actor (and bIsLocked is false) bIsOpen is true, and every frame the pivot component turns toward the open angle (or back to 0) over OpenTime. When the last pawn leaves, bAutoClose closes it after AutoCloseDelay; otherwise it stays open. The Blueprint holds bIsLocked, bAutoClose, AutoCloseDelay, OpenTime and the angle variable before this runs.",
  "tag": "OpenOnApproach",
  "placeholders": {
    "Pivot": "The scene component that turns (DoorPivot, LidPivot).",
    "AngleVariable": "The Float variable holding the open angle in degrees (OpenAngle, LidOpenAngle).",
    "RotatorPin": "The axis it turns about, as a MakeRotator pin: Yaw for a door, Pitch for a lid."
  },
  "variables": [
    { "variableName": "bIsOpen", "variableType": "Bool", "defaultValue": false, "category": "Interaction", "keepExisting": true },
    { "variableName": "PawnsInside", "variableType": "Int", "defaultValue": 0, "category": "Interaction" },
    { "variableName": "OpenAmount", "variableType": "Float", "defaultValue": 0, "category": "Interaction" }
  ],
  "hooks": [
    { "id": "openEnter", "event": "ActorBeginOverlap" },
    { "id": "openLeave", "event": "ActorEndOverlap" },
    { "id": "openTick", "event": "Tick" }
  ],
  "eventGraph": [
    { "edit": "create_node", "id": "enterPawn", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "enterCount", "nodeType": "VariableGet", "memberName": "PawnsInside" },
    { "edit": "create_node", "id": "enterAdd", "nodeType": "CallFunction", "memberName": "Add_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
    { "edit": "create_node", "id": "enterStore", "nodeType": "VariableSet", "memberName": "PawnsInside" },
    { "edit": "create_node", "id": "enterLocked", "nodeType": "VariableGet", "memberName": "bIsLocked" },
    { "edit": "create_node", "id": "enterUnlocked", "nodeType": "CallFunction", "memberName": "Not_PreBool", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "enterBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "enterOpen", "nodeType": "VariableSet", "memberName": "bIsOpen", "pinDefaults": { "bIsOpen": true } },
    { "edit": "connect_pins", "from": "$openEnter_event.OtherActor", "to": "$enterPawn.Object" },
    { "edit": "connect_pins", "from": "$enterCount.PawnsInside", "to": "$enterAdd.A" },
    { "edit": "connect_pins", "from": "$enterAdd.ReturnValue", "to": "$enterStore.PawnsInside" },
    { "edit": "connect_pins", "from": "$enterLocked.bIsLocked", "to": "$enterUnlocked.A" },
    { "edit": "connect_pins", "from": "$enterUnlocked.ReturnValue", "to": "$enterBranch.Condition" },
    { "edit": "connect_pins", "from": "$openEnter.then", "to": "$enterPawn.execute" },
    { "edit": "connect_pins", "from": "$enterPawn.then", "to": "$enterStore.execute" },
    { "edit": "connect_pins", "from": "$enterStore.then", "to": "$enterBranch.execute" },
    { "edit": "connect_pins", "from": "$enterBranch.then", "to": "$enterOpen.execute" },

    { "edit": "create_node", "id": "leavePawn", "nodeType": "Cast", "targetClass": "/Script/Engine.Pawn" },
    { "edit": "create_node", "id": "leaveCount", "nodeType": "VariableGet", "memberName": "PawnsInside" },
    { "edit": "create_node", "id": "leaveSub", "nodeType": "CallFunction", "memberName": "Subtract_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 1 } },
    { "edit": "create_node", "id": "leaveFloor", "nodeType": "CallFunction", "memberName": "Max", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "leaveStore", "nodeType": "VariableSet", "memberName": "PawnsInside" },
    { "edit": "create_node", "id": "leaveAuto", "nodeType": "VariableGet", "memberName": "bAutoClose" },
    { "edit": "create_node", "id": "leaveBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "leaveDelayTime", "nodeType": "VariableGet", "memberName": "AutoCloseDelay" },
    { "edit": "create_node", "id": "leaveWait", "nodeType": "CallFunction", "memberName": "Delay" },
    { "edit": "create_node", "id": "leaveRemaining", "nodeType": "VariableGet", "memberName": "PawnsInside" },
    { "edit": "create_node", "id": "leaveNone", "nodeType": "CallFunction", "memberName": "LessEqual_IntInt", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0 } },
    { "edit": "create_node", "id": "leaveEmptyBranch", "nodeType": "Branch" },
    { "edit": "create_node", "id": "leaveClose", "nodeType": "VariableSet", "memberName": "bIsOpen", "pinDefaults": { "bIsOpen": false } },
    { "edit": "connect_pins", "from": "$openLeave_event.OtherActor", "to": "$leavePawn.Object" },
    { "edit": "connect_pins", "from": "$leaveCount.PawnsInside", "to": "$leaveSub.A" },
    { "edit": "connect_pins", "from": "$leaveSub.ReturnValue", "to": "$leaveFloor.A" },
    { "edit": "connect_pins", "from": "$leaveFloor.ReturnValue", "to": "$leaveStore.PawnsInside" },
    { "edit": "connect_pins", "from": "$leaveAuto.bAutoClose", "to": "$leaveBranch.Condition" },
    { "edit": "connect_pins", "from": "$leaveDelayTime.AutoCloseDelay", "to": "$leaveWait.Duration" },
    { "edit": "connect_pins", "from": "$leaveRemaining.PawnsInside", "to": "$leaveNone.A" },
    { "edit": "connect_pins", "from": "$leaveNone.ReturnValue", "to": "$leaveEmptyBranch.Condition" },
    { "edit": "connect_pins", "from": "$openLeave.then", "to": "$leavePawn.execute" },
    { "edit": "connect_pins", "from": "$leavePawn.then", "to": "$leaveStore.execute" },
    { "edit": "connect_pins", "from": "$leaveStore.then", "to": "$leaveBranch.execute" },
    { "edit": "connect_pins", "from": "$leaveBranch.then", "to": "$leaveWait.execute" },
    { "edit": "connect_pins", "from": "$leaveWait.then", "to": "$leaveEmptyBranch.execute" },
    { "edit": "connect_pins", "from": "$leaveEmptyBranch.then", "to": "$leaveClose.execute" },

    { "edit": "create_node", "id": "tickOpen", "nodeType": "VariableGet", "memberName": "bIsOpen" },
    { "edit": "create_node", "id": "tickTarget", "nodeType": "CallFunction", "memberName": "SelectFloat", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "A": 1, "B": 0 } },
    { "edit": "create_node", "id": "tickAmount", "nodeType": "VariableGet", "memberName": "OpenAmount" },
    { "edit": "create_node", "id": "tickTime", "nodeType": "VariableGet", "memberName": "OpenTime" },
    { "edit": "create_node", "id": "tickTimeFloor", "nodeType": "CallFunction", "memberName": "FMax", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "B": 0.05 } },
    { "edit": "create_node", "id": "tickSpeed", "nodeType": "CallFunction", "memberName": "Divide_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary", "pinDefaults": { "A": 1 } },
    { "edit": "create_node", "id": "tickInterp", "nodeType": "CallFunction", "memberName": "FInterpTo_Constant", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "tickStore", "nodeType": "VariableSet", "memberName": "OpenAmount" },
    { "edit": "create_node", "id": "tickAngleValue", "nodeType": "VariableGet", "memberName": "{{AngleVariable}}" },
    { "edit": "create_node", "id": "tickAngle", "nodeType": "CallFunction", "memberName": "Multiply_DoubleDouble", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "tickRotation", "nodeType": "CallFunction", "memberName": "MakeRotator", "memberClass": "/Script/Engine.KismetMathLibrary" },
    { "edit": "create_node", "id": "tickPivot", "nodeType": "VariableGet", "memberName": "{{Pivot}}" },
    { "edit": "create_node", "id": "tickTurn", "nodeType": "CallFunction", "memberName": "K2_SetRelativeRotation", "memberClass": "/Script/Engine.SceneComponent" },
    { "edit": "connect_pins", "from": "$tickOpen.bIsOpen", "to": "$tickTarget.bPickA" },
    { "edit": "connect_pins", "from": "$tickTime.OpenTime", "to": "$tickTimeFloor.A" },
    { "edit": "connect_pins", "from": "$tickTimeFloor.ReturnValue", "to": "$tickSpeed.B" },
    { "edit": "connect_pins", "from": "$tickAmount.OpenAmount", "to": "$tickInterp.Current" },
    { "edit": "connect_pins", "from": "$tickTarget.ReturnValue", "to": "$tickInterp.Target" },
    { "edit": "connect_pins", "from": "$openTick_event.DeltaSeconds", "to": "$tickInterp.DeltaTime" },
    { "edit": "connect_pins", "from": "$tickSpeed.ReturnValue", "to": "$tickInterp.InterpSpeed" },
    { "edit": "connect_pins", "from": "$tickInterp.ReturnValue", "to": "$tickStore.OpenAmount" },
    { "edit": "connect_pins", "from": "$tickStore.Output_Get", "to": "$tickAngle.A" },
    { "edit": "connect_pins", "fromNodeId": "$tickAngleValue", "fromPinName": "{{AngleVariable}}", "toNodeId": "$tickAngle", "toPinName": "B" },
    { "edit": "connect_pins", "fromNodeId": "$tickAngle", "fromPinName": "ReturnValue", "toNodeId": "$tickRotation", "toPinName": "{{RotatorPin}}" },
    { "edit": "connect_pins", "fromNodeId": "$tickPivot", "fromPinName": "{{Pivot}}", "toNodeId": "$tickTurn", "toPinName": "self" },
    { "edit": "connect_pins", "from": "$tickRotation.ReturnValue", "to": "$tickTurn.NewRotation" },
    { "edit": "connect_pins", "from": "$openTick.then", "to": "$tickStore.execute" },
    { "edit": "connect_pins", "from": "$tickStore.then", "to": "$tickTurn.execute" }
  ]
}
