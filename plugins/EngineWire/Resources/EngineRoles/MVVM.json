      "type": { "cpp": "FName" }, "words": ["view", "model", "name"] },
    { "id": "MVVM.Context.Class", "kind": "property", "owner": "MVVM.ViewModelContext", "name": "NotifyFieldValueClass",
      "type": { "cpp": "UClass" }, "words": ["notify", "field", "class"] },
