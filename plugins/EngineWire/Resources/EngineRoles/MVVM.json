    { "id": "MVVM.Editor.AddViewModel", "kind": "function", "owner": "MVVM.EditorSubsystem", "name": "AddViewModel" },
    { "id": "MVVM.Editor.RemoveViewModel", "kind": "function", "owner": "MVVM.EditorSubsystem", "name": "RemoveViewModel" },
    { "id": "MVVM.Editor.RenameViewModel", "kind": "function", "owner": "MVVM.EditorSubsystem", "name": "RenameViewModel" },
    { "id": "MVVM.Editor.AddBinding", "kind": "function", "owner": "MVVM.EditorSubsystem", "name": "AddBinding" }
  ]
