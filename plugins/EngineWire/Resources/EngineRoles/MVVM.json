    { "id": "MVVM.FieldPath", "kind": "struct", "path": "/Script/ModelViewViewModelBlueprint.MVVMBlueprintFieldPath" },
    { "id": "MVVM.ViewModelBase", "kind": "class", "path": "/Script/ModelViewViewModel.MVVMViewModelBase" },
