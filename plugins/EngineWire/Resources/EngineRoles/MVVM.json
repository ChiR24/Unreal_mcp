    { "id": "MVVM.Binding.Mode", "kind": "property", "owner": "MVVM.Binding", "name": "BindingType",
      "type": { "enumWords": ["binding", "mode"] }, "words": ["binding", "type"] },
    { "id": "MVVM.Binding.Conversion", "kind": "property", "owner": "MVVM.Binding", "name": "Conversion",
      "type": { "role": "MVVM.ConversionPath" }, "words": ["conversion"] },

