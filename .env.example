# Server Settings
NODE_ENV=development
LOG_LEVEL=info

# Unreal Engine Settings
UE_PROJECT_PATH="C:/Users/YourName/Documents/Unreal Projects/YourProject/YourProject.uproject"


# Automation Bridge Connection (Node -> Unreal)
MCP_AUTOMATION_HOST=127.0.0.1
MCP_AUTOMATION_PORT=8091

# Network media URLs are disabled. Use filePath/mediaPath under Project Content
# or Project Saved for media input.

# Timeouts
MCP_CONNECTION_TIMEOUT_MS=5000
MCP_REQUEST_TIMEOUT_MS=30000

# Additional UE content path prefixes (comma-separated)
# Plugins with CanContainContent in their .uplugin register mount points beyond /Game/.
# Example: /ProjectObject/,/ProjectAnimation/,/MyPlugin/
# MCP_ADDITIONAL_PATH_PREFIXES=

# Legacy/Alternative Variables (for backward compatibility)
# MCP_AUTOMATION_WS_PORT=8090
# MCP_AUTOMATION_BRIDGE_ENABLED=true
