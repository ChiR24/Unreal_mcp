              },
              "required": [
                "title",
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "availability": {
            "type": "object",
            "properties": {
              "requiredPlugins": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "editorStates": {
                "type": "array",
                "items": {
                  "type": "string",
