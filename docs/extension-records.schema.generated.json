                      }
                    },
                    "required": [
                      "inverse"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "guidance": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "guidance"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "readBack": {
                "type": "object",
                "properties": {
                  "compare": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^\\$params\\.[A-Za-z][A-Za-z0-9]*$"
                    }
                  }
                },
                "required": [
                  "compare"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "effect",
              "idempotency",
              "longRunning",
              "safeToRetry"
            ],
            "additionalProperties": false
          },
          "policy": {
            "type": "object",
            "properties": {
              "requiredScope": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "destructive",
                  "admin"
                ]
              },
              "consent": {
                "type": "string",
                "enum": [
                  "none",
                  "explicit",
                  "elevated"
                ]
              },
              "dataAccess": {
                "type": "string",
                "enum": [
                  "none",
                  "project-read",
                  "project-write",
                  "engine-read"
                ]
              },
              "raisedBy": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "destructive",
                    "admin"
                  ]
                }
              },
              "consentRaisedBy": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "none",
                    "explicit",
                    "elevated"
                  ]
                }
              }
            },
            "required": [
              "requiredScope",
              "consent",
              "dataAccess"
            ],
            "additionalProperties": false
          },
          "cost": {
            "type": "object",
            "properties": {
              "latency": {
                "type": "string",
                "enum": [
                  "instant",
                  "interactive",
                  "long-running"
                ]
              },
              "resources": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "required": [
              "latency",
              "resources"
            ],
            "additionalProperties": false
          },
          "routing": {
            "type": "object",
            "properties": {
              "parentTool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "dispatchAction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "dispatchBy": {
                "type": "object",
                "properties": {
                  "param": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "declaredBy": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "requires": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "required": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "oneOf": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "param",
                  "actions"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "parentTool",
              "dispatchAction"
            ],
            "additionalProperties": false
          },
          "hashes": {
            "type": "object",
            "description": "Required, any values: EngineWire does not check an extension record's hashes."
          }
        },
        "required": [
          "id",
          "aliases",
          "legacyIds",
          "discovery",
          "schemas",
          "examples",
          "availability",
          "behavior",
          "policy",
          "cost",
          "routing",
          "hashes"
        ],
        "additionalProperties": false
      }
    }
  }
}
