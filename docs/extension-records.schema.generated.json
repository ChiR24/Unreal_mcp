                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "aliases": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 160,
                    "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
                  }
                }
              },
              "required": [
                "tool",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "discovery": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              },
              "whenToUse": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "whenNotToUse": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "domain",
              "family",
              "topics",
              "summary",
              "whenToUse",
              "whenNotToUse"
            ],
            "additionalProperties": false
          },
          "schemas": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string",
                    "const": "https://json-schema.org/draft/2020-12/schema"
                  },
                  "type": {
                    "type": "string",
                    "const": "object"
                  },
                  "properties": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    ]
                  },
                  "requiredOneOf": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "$schema",
                  "type",
                  "properties",
                  "required",
                  "additionalProperties"
                ],
                "additionalProperties": false
              },
              "output": {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string",
                    "const": "https://json-schema.org/draft/2020-12/schema"
                  },
                  "type": {
                    "type": "string",
                    "const": "object"
                  },
                  "properties": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    ]
                  },
                  "requiredOneOf": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "$schema",
                  "type",
                  "properties",
                  "required",
                  "additionalProperties"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "input",
              "output"
            ],
            "additionalProperties": false
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "output": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
