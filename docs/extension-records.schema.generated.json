          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
            }
          },
          "legacyIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9_]*$"
